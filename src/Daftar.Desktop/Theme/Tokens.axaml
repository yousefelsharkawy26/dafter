<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================
         Layer 1 — Design tokens.
         Raw numbers live ONLY here. Views never hard-code a size,
         spacing or font size; they reference these keys (or the
         semantic classes in Components.axaml).
         Colours are NOT defined here: they come from FluentAvaloniaTheme
         (accent, light/dark, system fills) so the whole app follows
         the theme and the accent colour in one place.
         ======================================================== -->

    <!-- Spacing scale (4-pt grid) -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>

    <Thickness x:Key="PagePadding">16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="TilePadding">12,10</Thickness>
    <Thickness x:Key="RowPadding">8,10</Thickness>

    <!-- Type scale -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeDisplay">32</x:Double>

    <!-- Component sizes -->
    <GridLength x:Key="CartPanelWidth">440</GridLength>
    <x:Double x:Key="TileMinWidth">200</x:Double>
    <x:Double x:Key="TileHeight">112</x:Double>
    <x:Double x:Key="ControlHeight">38</x:Double>
    <x:Double x:Key="ControlHeightLg">52</x:Double>
    <x:Double x:Key="SearchHeight">48</x:Double>
    <x:Double x:Key="IconButtonSize">32</x:Double>
    <GridLength x:Key="FieldLabelWidth">72</GridLength>

    <!-- Vector icons (emoji render badly on Linux) -->
    <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
    <StreamGeometry x:Key="IconCart">M17,18C15.89,18 15,18.89 15,20A2,2 0 0,0 17,22A2,2 0 0,0 19,20C19,18.89 18.1,18 17,18M1,2V4H3L6.6,11.59L5.24,14.04C5.09,14.32 5,14.65 5,15A2,2 0 0,0 7,17H19V15H7.42A0.25,0.25 0 0,1 7.17,14.75C7.17,14.7 7.18,14.66 7.2,14.63L8.1,13H15.55C16.3,13 16.96,12.58 17.3,11.97L20.88,5.5C20.95,5.34 21,5.17 21,5A1,1 0 0,0 20,4H5.21L4.27,2M7,18C5.89,18 5,18.89 5,20A2,2 0 0,0 7,22A2,2 0 0,0 9,20C9,18.89 8.1,18 7,18Z</StreamGeometry>
</ResourceDictionary>

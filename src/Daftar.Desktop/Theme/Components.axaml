<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================
         Layer 2 — Semantic classes.
         Views say WHAT something is (Classes="price", "badge warning",
         "panel"); this file decides HOW it looks, using only tokens
         from Tokens.axaml and brushes from FluentAvaloniaTheme.
         Want a different look? Change it here once.
         ======================================================== -->

    <!-- ───────────── Typography ───────────── -->
    <Style Selector="TextBlock.caption, TextBlock.muted">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.price">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.caution">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <!-- ───────────── Surfaces ───────────── -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    </Style>
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>
    <Style Selector="Border.divider-top">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.divider-bottom">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- ───────────── Badges: <Border Classes="badge warning"> ───────────── -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.badge.warning">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge.warning > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Border.badge.danger">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge.danger > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="Border.badge.success">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge.success > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <!-- Used once, on the receive tile, and never defined anywhere until now: the on-hand
         figure rendered as a bare number floating on the tile with no chip around it and nothing
         to say what it counted. A translucent white pill reads on the blue tile, and white text
         is what the tile already sets, so this only has to supply the shape. -->
    <Style Selector="Border.badge.info">
        <Setter Property="Background" Value="#40FFFFFF" />
    </Style>
    <Style Selector="Border.badge.info > TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Border.badge.count">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="Border.badge.count > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ───────────── Buttons ─────────────
         Primary action  → FluentAvalonia's built-in Classes="accent"
         Everything else → the classes below -->

    <!-- Product tile -->
    <Style Selector="Button.tile">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource TilePadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.tile:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- Quiet text button -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Square icon button -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="{DynamicResource IconButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Delete icon: quiet until hovered, then red -->
    <Style Selector="Button.remove PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.remove:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Destructive confirm -->
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- ───────────── Inputs ───────────── -->
    <!-- Money box: typed amounts, no spinner -->
    <Style Selector="NumericUpDown.money">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="FormatString" Value="N2" />
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Quantity box: typed (100 kg) or nudged with the spinner -->
    <Style Selector="NumericUpDown.qty">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Increment" Value="1" />
        <Setter Property="FormatString" Value="0.###" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</Styles>

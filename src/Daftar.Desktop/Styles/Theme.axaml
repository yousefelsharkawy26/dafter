<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cairo covers Arabic and Latin; without it Avalonia falls back to a font with no Arabic. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Cairo" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="Background" Value="#F3F3F3" />
    </Style>

    <!-- ==============================================
         Global Windows 8 / Metro Zero Corner Radius
         ============================================== -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="AutoCompleteBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Thumb">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- ==============================================
         Windows 8 App Bar (Top Navigation Header)
         ============================================== -->
    <Style Selector="Border.app-bar">
        <Setter Property="Background" Value="#1F1F1F" />
        <Setter Property="BorderBrush" Value="#0078D7" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.app-bar Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="BorderBrush" Value="#555555" />
    </Style>
    <Style Selector="Border.app-bar Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="BorderBrush" Value="#777777" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Launcher buttons in top bar -->
    <Style Selector="Button.launcher">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.launcher:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0078D7" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.launcher:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#005A9E" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ==============================================
         Tab strip: Windows 8 flat tabs / pivot style
         ============================================== -->
    <Style Selector="TabControl.tabs">
        <Setter Property="Background" Value="#F3F3F3" />
    </Style>

    <Style Selector="TabControl.tabs > TabStrip">
        <Setter Property="Background" Value="#E6E6E6" />
        <Setter Property="Height" Value="40" />
    </Style>

    <Style Selector="TabControl.tabs TabItem">
        <Setter Property="Background" Value="#D8D8D8" />
        <Setter Property="Foreground" Value="#444444" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0,3,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TabControl.tabs TabItem:pointerover">
        <Setter Property="Background" Value="#E2E2E2" />
        <Setter Property="Foreground" Value="#000000" />
    </Style>
    <Style Selector="TabControl.tabs TabItem:selected">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#0078D7" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderBrush" Value="#0078D7" />
        <Setter Property="BorderThickness" Value="0,3,0,0" />
    </Style>

    <!-- Tab close button: Metro red hover -->
    <Style Selector="Button.tab-close">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#777777" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E51400" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ==============================================
         Panels and cards
         ============================================== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="#D9D9D9" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1F1F1F" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ==============================================
         Windows 8 Live Tiles
         ============================================== -->
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="#0078D7" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="190" />
        <Setter Property="MinHeight" Value="100" />
    </Style>
    <Style Selector="Border.tile:pointerover">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <!-- Specific Windows 8 Metro Tile Accent Colors -->
    <Style Selector="Border.tile-emerald">
        <Setter Property="Background" Value="#008A00" />
    </Style>
    <Style Selector="Border.tile-blue">
        <Setter Property="Background" Value="#0078D7" />
    </Style>
    <Style Selector="Border.tile-purple">
        <Setter Property="Background" Value="#6B0096" />
    </Style>
    <Style Selector="Border.tile-orange">
        <Setter Property="Background" Value="#D24726" />
    </Style>
    <Style Selector="Border.tile-crimson">
        <Setter Property="Background" Value="#E51400" />
    </Style>
    <Style Selector="Border.tile-teal">
        <Setter Property="Background" Value="#008272" />
    </Style>
    <Style Selector="Border.tile-amber">
        <Setter Property="Background" Value="#E3A21A" />
    </Style>

    <!-- Typography inside Live Tiles -->
    <Style Selector="Border.tile TextBlock.tile-value">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="Border.tile TextBlock.tile-label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#F0FFFFFF" />
    </Style>

    <!-- Typography for tile-value and tile-label outside of Border.tile -->
    <Style Selector="TextBlock.tile-value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#0078D7" />
    </Style>
    <Style Selector="TextBlock.tile-label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#666666" />
    </Style>

    <!-- ==============================================
         Action buttons
         ============================================== -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#CCCCCC" />
        <Setter Property="Background" Value="#F2F2F2" />
        <Setter Property="Foreground" Value="#1F1F1F" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E0E0E0" />
        <Setter Property="BorderBrush" Value="#999999" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#CCCCCC" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#0078D7" />
        <Setter Property="BorderBrush" Value="#0078D7" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A86E8" />
        <Setter Property="BorderBrush" Value="#1A86E8" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#005A9E" />
        <Setter Property="BorderBrush" Value="#005A9E" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#CCCCCC" />
        <Setter Property="BorderBrush" Value="#CCCCCC" />
        <Setter Property="TextBlock.Foreground" Value="#767676" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#E51400" />
        <Setter Property="BorderBrush" Value="#E51400" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#EA3C2A" />
        <Setter Property="BorderBrush" Value="#EA3C2A" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#BF1100" />
        <Setter Property="BorderBrush" Value="#BF1100" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="BorderBrush" Value="#B0B0B0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E5E5E5" />
        <Setter Property="TextBlock.Foreground" Value="#000000" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#CCCCCC" />
    </Style>

    <!-- ==============================================
         Inputs
         ============================================== -->
    <Style Selector="TextBox, AutoCompleteBox">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#B0B0B0" />
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#666666" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#0078D7" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#B0B0B0" />
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="#666666" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="#0078D7" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="#0078D7" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ==============================================
         DataGrid
         ============================================== -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EAEAEA" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="#F2F2F2" />
        <Setter Property="Foreground" Value="#1F1F1F" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="#D9D9D9" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="#0078D7" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="#E8F1F9" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- ==============================================
         ListBox
         ============================================== -->
    <Style Selector="ListBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#0078D7" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E8F1F9" />
    </Style>

    <!-- ==============================================
         Status Bar
         ============================================== -->
    <Style Selector="Border.status">
        <Setter Property="Background" Value="#EBEBEB" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- ==============================================
         Windows 8 Start Menu Button & Tiles
         ============================================== -->
    <Style Selector="Button.start-btn">
        <Setter Property="Background" Value="#0078D7" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.start-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A86E8" />
        <Setter Property="TextBlock.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.start-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#005A9E" />
        <Setter Property="TextBlock.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.start-tile">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.start-tile:pointerover /template/ ContentPresenter">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.start-tile:pressed /template/ ContentPresenter">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="#99D9FF" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
</Styles>
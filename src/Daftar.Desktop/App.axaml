<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Daftar"
             x:Class="Daftar.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="#0078D7"
                                       RegionColor="#F3F3F3" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <!-- DataGrid lives in a separate package and ships its own theme. Without this
             include every DataGrid in the app renders as blank space: no headers, no rows. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Daftar.Desktop/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Daftar"
             xmlns:conv="using:Daftar.Converters"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Daftar.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Daftar.Desktop/Theme/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- bool to an icon and to a colour. The login window used to fake both with
                 a null converter, which rendered the word "False" on screen. -->
            <conv:BoolToMarkConverter x:Key="BoolToMark" />
            <conv:BoolToBrushConverter x:Key="BoolToBrush" />
            <conv:BoolToBrushConverter x:Key="BoolToDimBrush" Dim="True" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="#0078D7"
                                       RegionColor="#F3F3F3" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <sty:FluentAvaloniaTheme />
        <!-- DataGrid lives in a separate package and ships its own theme. Without this
             include every DataGrid in the app renders as blank space: no headers, no rows. -->
        <StyleInclude Source="avares://Daftar.Desktop/Styles/Theme.axaml" />
        <StyleInclude Source="avares://Daftar.Desktop/Theme/Components.axaml" />
    </Application.Styles>
</Application>
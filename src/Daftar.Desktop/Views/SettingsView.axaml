<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daftar.ViewModels"
             xmlns:views="using:Daftar.Views"
             x:Class="Daftar.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <!-- ========================================================
             1. Header: Title & Status
             ======================================================== -->
        <Border Grid.Row="0" Classes="panel" Margin="0,0,0,12" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="الإعدادات وإدارة النظام" Classes="subtitle" FontWeight="Bold" />
                    <TextBlock Text="إعدادات بيانات الشركة، حسابات المستخدمين، الأدوار والصلاحيات، والنسخ الاحتياطي" Classes="caption muted" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="90" Height="4" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="caption muted" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================
             2. Section Tabs Navigation Bar
             ======================================================== -->
        <Border Grid.Row="1" Classes="panel" Margin="0,0,0,14" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="tab-btn" Classes.accent="{Binding IsCompanySectionActive}"
                        Command="{Binding SelectCompanySectionCommand}" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🏢" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="بيانات الشركة والفاتورة" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="tab-btn" Classes.accent="{Binding IsUsersSectionActive}"
                        Command="{Binding SelectUsersSectionCommand}" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="المستخدمين والحسابات" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="tab-btn" Classes.accent="{Binding IsRolesSectionActive}"
                        Command="{Binding SelectRolesSectionCommand}" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="الأدوار والصلاحيات" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="tab-btn" Classes.accent="{Binding IsBackupSectionActive}"
                        Command="{Binding SelectBackupSectionCommand}" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="النسخ الاحتياطي والأمان" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="tab-btn" Classes.accent="{Binding IsErrorsSectionActive}"
                        Command="{Binding SelectErrorsSectionCommand}" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="سجل الأخطاء" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ========================================================
             3. Active Section Content Host
             ======================================================== -->
        <Panel Grid.Row="2">

            <!-- ── SECTION 0: Company & Invoice Settings ────────────── -->
            <ScrollViewer IsVisible="{Binding IsCompanySectionActive}">
                <StackPanel Spacing="16" MinWidth="700" HorizontalAlignment="Left">
                    <!-- Company Info Card -->
                    <Border Classes="panel" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="heading" Text="بيانات الشركة والمؤسسة" />

                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption muted" Text="اسم الشركة أو النشاط التجاري *" />
                                <TextBox Text="{Binding CompanyName, Mode=TwoWay}"
                                         PlaceholderText="اسم الشركة كما يظهر على الفواتير"
                                         Height="38" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="caption muted" Text="رقم الهاتف والتواصل" />
                                    <TextBox Text="{Binding Phone, Mode=TwoWay}" PlaceholderText="01xxxxxxxxx"
                                             Height="38" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="caption muted" Text="الرقم الضريبي / السجل التجاري" />
                                    <TextBox Text="{Binding TaxNumber, Mode=TwoWay}" PlaceholderText="اختياري"
                                             Height="38" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption muted" Text="عنوان المقر الرئيسي أو الفرع" />
                                <TextBox Text="{Binding Address, Mode=TwoWay}"
                                         PlaceholderText="عنوان الشركة بالتفصيل"
                                         AcceptsReturn="True"
                                         Height="68" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Receipt Customization Card -->
                    <Border Classes="panel" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="heading" Text="إعدادات الفاتورة والإيصالات" />

                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption muted" Text="نص تذييل الفاتورة المطبوعة (رسالة ختامية)" />
                                <TextBox Text="{Binding ReceiptFooter, Mode=TwoWay}"
                                         PlaceholderText="مثال: شكراً لتعاملكم معنا، البضاعة المباعة ترد وتستبدل خلال 14 يوماً."
                                         AcceptsReturn="True"
                                         Height="80" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Save Action -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   Classes="caption muted" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="accent" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding !IsBusy}" Padding="24,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✓" FontWeight="Bold" />
                                <TextBlock Text="حفظ إعدادات الشركة" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ── SECTION 1: Users Management ───────────────────────── -->
            <Border Classes="panel" Padding="16" IsVisible="{Binding IsUsersSectionActive}">
                <DockPanel LastChildFill="True">
                    <!-- Top Action Bar -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="قائمة المستخدمين والحسابات" Classes="heading" />
                            <TextBlock Text="إدارة حسابات الدخول، كلمة المرور، وتعيين الأدوار الوظيفية" Classes="caption muted" />
                        </StackPanel>

                        <Button Grid.Column="1" Classes="accent" Command="{Binding OpenAddUserDialogCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="إضافة مستخدم جديد" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Users DataGrid -->
                    <DataGrid ItemsSource="{Binding UsersList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="140" />
                            <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*" />
                            <DataGridTextColumn Header="الدور الوظيفي" Binding="{Binding RoleName}" Width="150" />
                            <DataGridTemplateColumn Header="الحالة" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:UserListItem">
                                        <Border Classes="badge" Background="{Binding StatusColor}" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="آخر تسجيل دخول" Binding="{Binding LastLoginText}" Width="150" />
                            <DataGridTemplateColumn Header="إجراءات" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:UserListItem">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Button Classes="icon"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenEditUserDialogCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="تعديل بيانات المستخدم وكلمة المرور">
                                                <TextBlock Text="✏️" FontSize="13" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ToggleUserActiveCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="تفعيل أو تعطيل الحساب">
                                                <TextBlock Text="🔒" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── SECTION 2: Roles & Permissions ────────────────────── -->
            <Border Classes="panel" Padding="16" IsVisible="{Binding IsRolesSectionActive}">
                <DockPanel LastChildFill="True">
                    <!-- Top Action Bar -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="الأدوار والصلاحيات (Security Roles)" Classes="heading" />
                            <TextBlock Text="تحديد الأدوار الوظيفية، نسبة الخصم المسموحة، والصلاحيات التفصيلية" Classes="caption muted" />
                        </StackPanel>

                        <Button Grid.Column="1" Classes="accent" Command="{Binding OpenAddRoleDialogCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="إضافة دور جديد" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Roles DataGrid -->
                    <DataGrid ItemsSource="{Binding RolesList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الدور" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="أقصى نسبة خصم" Binding="{Binding MaxDiscountText}" Width="130" />
                            <DataGridTextColumn Header="عدد الصلاحيات" Binding="{Binding PermissionsCount}" Width="110" />
                            <DataGridTextColumn Header="ملخص الصلاحيات" Binding="{Binding PermissionsSummary}" Width="3*" />
                            <DataGridTemplateColumn Header="تعديل" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:RoleListItem">
                                        <Button Classes="icon"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenEditRoleDialogCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Center"
                                                ToolTip.Tip="تعديل الدور والصلاحيات">
                                            <TextBlock Text="✏️" FontSize="13" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── SECTION 3: Backup & Safety ────────────────────────── -->
            <ScrollViewer IsVisible="{Binding IsBackupSectionActive}">
                <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Classes="panel" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="heading" Text="النسخ الاحتياطي لقاعدة البيانات" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="حفظ نسخة احتياطية دورية يضمن سلامة عمليات البيع، المخزون، والبيانات المالية عند حدوث أي طارئ على الجهاز. يتم أخذ النسخة مباشرة وبشكل آمن أثناء تشغيل البرنامج." />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,8,0,0">
                                <Button Grid.Column="0" Classes="accent" Command="{Binding CreateBackupCommand}"
                                        IsEnabled="{Binding !IsBackupBusy}" Padding="20,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="أخذ نسخة احتياطية الآن" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding BackupStatusMessage}" Classes="caption strong" />
                                    <TextBlock Text="{Binding LastBackupPath, StringFormat='المسار: {0}'}"
                                               Classes="caption muted" TextWrapping="Wrap"
                                               IsVisible="{Binding LastBackupPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="heading" Text="النسخ الموجودة" />

                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="ترجع أي نسخة من دول؟ لازم تقفل دفتر بعد ما تختار، وتفتحه تاني عشان الاستعادة تنفع." />

                            <Border Background="#FFF4E5" CornerRadius="6" Padding="12"
                                    IsVisible="{Binding HasPendingRestore}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⏳" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="{Binding PendingRestore.Name, StringFormat='الاستعادة متجدولة للنسخة {0}. اقفل دفتر وافتحه تاني.'}" />
                                    <Button Command="{Binding CancelRestoreCommand}" Content="إلغاء" />
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="muted" Text="مفيش نسخ محفوظة لحد دلوقتي."
                                       IsVisible="{Binding HasNoBackups}" />

                            <ItemsControl ItemsSource="{Binding Backups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1A1A" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CreatedDisplay}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding SizeDisplay}" Classes="caption muted" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="caption muted"
                                                           Text="{Binding Name}" />
                                                <Button Grid.Column="2" VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ScheduleRestoreCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="استعادة" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── SECTION 4: Error Log ────────────────────────────────
                 The real view, hosted rather than copied, so it keeps its
                 own layout and its own load-on-open.

                 The visibility sits on the wrapper because the child
                 declares its own x:DataType, which is what its inherited
                 bindings would then be compiled against. -->
            <Panel IsVisible="{Binding IsErrorsSectionActive}">
                <views:ErrorsView DataContext="{Binding Errors}" />
            </Panel>

        </Panel>

        <!-- ========================================================
             4. Floating Modal Dialog: User (إضافة / تعديل مستخدم)
             ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsUserDialogOpen}"
              ZIndex="1000">

            <!-- Backdrop -->
            <Button Command="{Binding CloseUserDialogCommand}"
                    Background="#77000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="0" />

            <!-- Centered Modal Card -->
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="520"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 14 40 0 #66000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Dialog Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0"
                            Padding="20,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding UserDialogTitle}" Classes="subtitle" FontWeight="Bold" />
                                <TextBlock Text="أدخل بيانات المستخدم وصلاحيات الدخول ثم اضغط حفظ" Classes="caption muted" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseUserDialogCommand}"
                                    Width="34" Height="34" FontSize="15" FontWeight="Bold" ToolTip.Tip="إغلاق">
                                <TextBlock Text="✕" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Dialog Body -->
                    <ScrollViewer Grid.Row="1" Padding="20,16" MaxHeight="460">
                        <StackPanel Spacing="14">
                            <!-- Username -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="اسم المستخدم (لتسجيل الدخول) *" Classes="caption muted" />
                                <TextBox Text="{Binding UserFormUsername, Mode=TwoWay}"
                                         PlaceholderText="مثال: ahmed أو cashier1"
                                         Height="38" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Full Name -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="الاسم الكامل للمستخدم *" Classes="caption muted" />
                                <TextBox Text="{Binding UserFormFullName, Mode=TwoWay}"
                                         PlaceholderText="مثال: أحمد محمد علي"
                                         Height="38" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Role ComboBox -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="الدور الوظيفي *" Classes="caption muted" />
                                <ComboBox ItemsSource="{Binding RoleOptions}"
                                          SelectedItem="{Binding UserFormSelectedRole, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RoleOption">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Password -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="كلمة المرور" Classes="caption muted" />
                                <TextBox Text="{Binding UserFormPassword, Mode=TwoWay}"
                                         PasswordChar="●"
                                         PlaceholderText="أدخل كلمة المرور (أو اتركها فارغة للإبقاء على الحالية)"
                                         Height="38" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Checkboxes -->
                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding UserFormIsActive, Mode=TwoWay}" Content="حساب نشط ومفعل" />
                                <CheckBox IsChecked="{Binding UserFormMustChangePassword, Mode=TwoWay}" Content="إلزام المستخدم بتغيير كلمة المرور عند أول تسجيل دخول" />
                            </StackPanel>

                            <!-- Error message -->
                            <TextBlock Text="{Binding UserDialogError}" Classes="caption danger"
                                       IsVisible="{Binding UserDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Footer -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <ProgressBar Grid.Column="0" IsIndeterminate="True"
                                         IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Height="4" />
                            <Button Grid.Column="1" Classes="ghost" Content="إلغاء"
                                    Command="{Binding CloseUserDialogCommand}" Height="36" Padding="16,6" />
                            <Button Grid.Column="2" Classes="accent" Command="{Binding SaveUserCommand}"
                                    Height="36" Padding="20,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="✓" FontWeight="Bold" />
                                    <TextBlock Text="حفظ المستخدم" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================
             5. Floating Modal Dialog: Role (إضافة / تعديل دور وصلاحيات)
             ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsRoleDialogOpen}"
              ZIndex="1000">

            <!-- Backdrop -->
            <Button Command="{Binding CloseRoleDialogCommand}"
                    Background="#77000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="0" />

            <!-- Centered Modal Card -->
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="620"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 14 40 0 #66000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Dialog Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0"
                            Padding="20,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding RoleDialogTitle}" Classes="subtitle" FontWeight="Bold" />
                                <TextBlock Text="حدد مسمى الدور، أقصى نسبة خصم، والصلاحيات الممنوحة" Classes="caption muted" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseRoleDialogCommand}"
                                    Width="34" Height="34" FontSize="15" FontWeight="Bold" ToolTip.Tip="إغلاق">
                                <TextBlock Text="✕" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Dialog Body -->
                    <ScrollViewer Grid.Row="1" Padding="20,16" MaxHeight="480">
                        <StackPanel Spacing="14">
                            <!-- Role Name & Max Discount -->
                            <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="اسم الدور الوظيفي *" Classes="caption muted" />
                                    <TextBox Text="{Binding RoleFormName, Mode=TwoWay}"
                                             PlaceholderText="مثال: كاشير، أمين مستودع، مشرف مبيعات"
                                             Height="38" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="أقصى نسبة خصم مسموحة (%)" Classes="caption muted" />
                                    <TextBox Text="{Binding RoleFormMaxDiscount, Mode=TwoWay}"
                                             PlaceholderText="0 إلى 100"
                                             Height="38" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,4" />

                            <!-- Permissions Checklist -->
                            <TextBlock Text="الصلاحيات المتاحة لهذا الدور:" Classes="strong" />

                            <ItemsControl ItemsSource="{Binding RolePermissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PermissionCheckItem">
                                        <Border Classes="surface" Margin="0,0,0,8" Padding="12,8">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                <StackPanel Spacing="2" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Classes="caption muted" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Error message -->
                            <TextBlock Text="{Binding RoleDialogError}" Classes="caption danger"
                                       IsVisible="{Binding RoleDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Footer -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <ProgressBar Grid.Column="0" IsIndeterminate="True"
                                         IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Height="4" />
                            <Button Grid.Column="1" Classes="ghost" Content="إلغاء"
                                    Command="{Binding CloseRoleDialogCommand}" Height="36" Padding="16,6" />
                            <Button Grid.Column="2" Classes="accent" Command="{Binding SaveRoleCommand}"
                                    Height="36" Padding="20,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="✓" FontWeight="Bold" />
                                    <TextBlock Text="حفظ الدور والصلاحيات" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>

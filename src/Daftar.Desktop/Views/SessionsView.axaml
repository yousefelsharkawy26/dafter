<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daftar.ViewModels"
             x:Class="Daftar.Views.SessionsView"
             x:DataType="vm:SessionsViewModel"
             FlowDirection="RightToLeft">

    <!-- Root grid: row0=status bar, row1=tabs, then overlay spans both -->
    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- Status bar -->
        <Border Grid.Row="0" Classes="card" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" FontSize="13" />
                <Button Grid.Column="1" Classes="ghost" Content="🔄 تحديث" Command="{Binding LoadCommand}" />
            </Grid>
        </Border>

        <!-- Tab control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ═══════════════════════════════════════════════════════
            Tab 1: Sessions (جولات الموزعين)
            ═══════════════════════════════════════════════════════ -->
            <TabItem Header="📋 جولات الموزعين">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0" RowSpacing="10">

                    <!-- KPI tiles -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="الجولات المفتوحة" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding OpenSessionsCountText}" FontSize="18" FontWeight="Bold"
                                           Foreground="#0078D7" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي المبيعات" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding TotalSalesText}" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي التحصيلات" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding TotalCollectionsText}" FontSize="18" FontWeight="Bold" Foreground="#107C41" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي العمولات" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding TotalCommissionsText}" FontSize="18" FontWeight="Bold" Foreground="#8764B8" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Action bar -->
                    <Border Grid.Row="1" Classes="card" Padding="10">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Classes="primary" Content="➕ بدء جولة جديدة"
                                    Command="{Binding OpenSessionWizardCommand}" />
                            <Button Grid.Column="1" Classes="ghost" Content="📄 تفاصيل وفواتير الجولة"
                                    Command="{Binding ViewSessionDetailsCommand}"
                                    CommandParameter="{Binding SelectedSession}"
                                    IsEnabled="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" FontSize="12"
                                       Text="لبدء الجولة أو التسوية، اضغط الزر المناسب أو اختر جولة من الجدول لعرض فواتيرها وحركاتها." />
                        </Grid>
                    </Border>

                    <!-- Sessions grid -->
                    <Border Grid.Row="2" Classes="card" Padding="8">
                        <DataGrid ItemsSource="{Binding Rows}"
                                  SelectedItem="{Binding SelectedSession}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"           Binding="{Binding Id}"                  Width="55" />
                                <DataGridTextColumn Header="الموزع"      Binding="{Binding DistributorName}"     Width="2*" />
                                <DataGridTextColumn Header="وقت الفتح"   Binding="{Binding OpenedAt}"            Width="*" />
                                <DataGridTextColumn Header="وقت الإغلاق" Binding="{Binding ClosedAt}"            Width="*" />
                                <DataGridTextColumn Header="الحالة"      Binding="{Binding StatusLabel}"         Width="*" />
                                <DataGridTextColumn Header="إجمالي البيع" Binding="{Binding SalesText}"          Width="*" />
                                <DataGridTextColumn Header="كاش مبيعات"  Binding="{Binding CashSalesText}"       Width="*" />
                                <DataGridTextColumn Header="تحصيل ديون"  Binding="{Binding DebtCollectionsText}" Width="*" />
                                <DataGridTextColumn Header="إجمالي النقدية" Binding="{Binding TotalCashText}"    Width="*" />
                                <DataGridTextColumn Header="العمولة"     Binding="{Binding CommissionText}"      Width="*" />
                                <DataGridTextColumn Header="فرق الكاش"   Binding="{Binding CashDiffText}"        Width="*" />
                                <DataGridTemplateColumn Header="إجراءات" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:SessionRow">
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                                <Button Classes="ghost" Content="📄 فواتير"
                                                        Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).ViewSessionDetailsCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,3" FontSize="12" />
                                                <Button Classes="ghost" Content="⚖ تسوية"
                                                        Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).OpenSettleWizardCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding IsOpen}"
                                                        Padding="8,3" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════
            Tab 2: Distributors Management
            ═══════════════════════════════════════════════════════ -->
            <TabItem Header="👥 إدارة الموزعين">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0" RowSpacing="10">

                    <Border Grid.Row="0" Classes="card" Padding="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Button Grid.Column="0" Classes="primary" Content="➕ إضافة موزع جديد"
                                    Command="{Binding OpenAddDistributorFormCommand}" />
                            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" FontSize="13"
                                       Text="إدارة بيانات المندوبين، مركبات التوزيع، ونسب العمولات." />
                            <Button Grid.Column="2" Classes="ghost" Content="تعديل الموزع المحدد"
                                    Command="{Binding OpenEditDistributorFormCommand}"
                                    CommandParameter="{Binding SelectedDistributor}"
                                    IsEnabled="{Binding SelectedDistributor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="card" Padding="14"
                            IsVisible="{Binding IsDistributorFormVisible}"
                            BorderBrush="#0078D7" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding DistributorFormTitle}" FontSize="16" FontWeight="Bold" />
                                <Button Grid.Column="1" Classes="ghost" Content="✕ إغلاق" Command="{Binding CloseDistributorFormCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="اسم الموزع *" FontSize="12" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding DistributorFormName}" PlaceholderText="اسم المندوب" Height="36" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="رقم الهاتف" FontSize="12" Classes="muted" />
                                    <TextBox Text="{Binding DistributorFormPhone}" PlaceholderText="01xxxxxxxxx" Height="36" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="السيارة / المركبة *" FontSize="12" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding DistributorFormVehicle}" PlaceholderText="رقم أو اسم السيارة" Height="36" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="نسبة العمولة (%) *" FontSize="12" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding DistributorFormCommissionRate}" PlaceholderText="0.0" Height="36" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Text="أساس العمولة" FontSize="12" Classes="muted" />
                                    <ComboBox ItemsSource="{Binding CommissionBasisChoices}"
                                              SelectedItem="{Binding SelectedCommissionBasisChoice}"
                                              HorizontalAlignment="Stretch" Height="36">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommissionBasisOption">
                                                <TextBlock Text="{Binding Label}" FontSize="13" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                <Button Grid.Column="0" Classes="primary" Content="💾 حفظ"
                                        Command="{Binding SaveDistributorCommand}" Height="36" Padding="18,0" />
                                <Button Grid.Column="1" Classes="ghost" Content="إلغاء"
                                        Command="{Binding CloseDistributorFormCommand}" Height="36" />
                                <TextBlock Grid.Column="2" Text="{Binding DistributorFormError}"
                                           Foreground="#D24726" FontWeight="SemiBold" VerticalAlignment="Center"
                                           IsVisible="{Binding DistributorFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Classes="card" Padding="8">
                        <DataGrid ItemsSource="{Binding Distributors}"
                                  SelectedItem="{Binding SelectedDistributor}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم"         Binding="{Binding Name}"               Width="1.5*" />
                                <DataGridTextColumn Header="الهاتف"        Binding="{Binding Phone}"              Width="120" />
                                <DataGridTextColumn Header="السيارة"       Binding="{Binding VehicleName}"        Width="140" />
                                <DataGridTextColumn Header="حساب العهدة"   Binding="{Binding CustodyAccountName}" Width="160" />
                                <DataGridTextColumn Header="العمولة"       Binding="{Binding CommissionText}"     Width="180" />
                                <DataGridTextColumn Header="الحالة"        Binding="{Binding StatusLabel}"        Width="80" />
                                <DataGridTextColumn Header="حالة الجولة"   Binding="{Binding SessionStatusText}"  Width="130" />
                                <DataGridTemplateColumn Header="إجراءات" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:DistributorManageRow">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Classes="ghost" Content="تعديل"
                                                        Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).OpenEditDistributorFormCommand}"
                                                        CommandParameter="{Binding}" Padding="6,2" FontSize="12" />
                                                <Button Classes="ghost" Content="{Binding ActiveToggleText}"
                                                        Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).ToggleDistributorActiveCommand}"
                                                        CommandParameter="{Binding}" Padding="6,2" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════
            Tab 3: Reports
            ═══════════════════════════════════════════════════════ -->
            <TabItem Header="📊 تقارير الموزعين">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0" RowSpacing="10">

                    <Border Grid.Row="0" Classes="card" Padding="12">
                        <Grid ColumnDefinitions="Auto,240,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="تصفية حسب الموزع:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DistributorFilterChoices}"
                                      SelectedItem="{Binding SelectedDistributorFilter}"
                                      HorizontalAlignment="Stretch" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DistributorFilterOption">
                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" FontSize="12"
                                       Text="مؤشرات المبيعات والتحصيلات والعمولات وفروق الكاش." />
                            <Button Grid.Column="3" Classes="ghost" Content="🔄 تحديث" Command="{Binding LoadCommand}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي الجولات" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding ReportSessionsCountText}" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي المبيعات" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding ReportTotalSalesText}" FontSize="18" FontWeight="Bold"
                                           Foreground="#0078D7" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي التحصيلات" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding ReportTotalCollectionsText}" FontSize="18" FontWeight="Bold" Foreground="#107C41" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="إجمالي العمولات" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding ReportTotalCommissionsText}" FontSize="18" FontWeight="Bold" Foreground="#8764B8" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Classes="card" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="صافي فروق الكاش" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding ReportNetCashDiffText}" FontSize="18" FontWeight="Bold" Foreground="#D24726" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Classes="card" Padding="8">
                        <DataGrid ItemsSource="{Binding ReportRows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserResizeColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموزع"            Binding="{Binding DistributorName}"    Width="1.8*" />
                                <DataGridTextColumn Header="عدد الجولات"       Binding="{Binding SessionsCount}"      Width="100" />
                                <DataGridTextColumn Header="إجمالي المبيعات"   Binding="{Binding SalesText}"          Width="140" />
                                <DataGridTextColumn Header="إجمالي التحصيلات"  Binding="{Binding CollectionsText}"    Width="140" />
                                <DataGridTextColumn Header="نسبة العمولة"      Binding="{Binding CommissionRateText}" Width="100" />
                                <DataGridTextColumn Header="العمولة المستحقة"  Binding="{Binding CommissionText}"     Width="140" />
                                <DataGridTextColumn Header="فروق الكاش"        Binding="{Binding CashDiffText}"       Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══════════════════════════════════════════════════════════════════
        WIZARD OVERLAY — spans both rows, sits above everything
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsWizardVisible}">

            <!-- Dark Backdrop -->
            <Border Background="#88000000" />

            <!-- Centered Dialog Card — 100% Solid Opaque -->
            <Border Background="#FFFFFF"
                    BorderBrush="#0078D7"
                    BorderThickness="2"
                    Width="940" Height="650"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 35 0 #88000000"
                    Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- ── Wizard header ─────────────────────────────────── -->
                    <Border Grid.Row="0"
                            Background="#0078D7"
                            Padding="20,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding WizardTitle}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="✕" Classes="ghost"
                                    Command="{Binding WizardCancelCommand}"
                                    Foreground="#FFFFFF" Background="Transparent"
                                    BorderThickness="0"
                                    Width="32" Height="32" Padding="0"
                                    FontSize="16" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <!-- ── Wizard body (step-dependent) ─────────────────── -->
                    <ScrollViewer Grid.Row="1" Padding="20,16" Background="#F8F9FA">
                        <Panel>

                            <!-- STEP 1: Open_Distributor — choose distributor -->
                            <StackPanel Spacing="16"
                                        IsVisible="{Binding IsWizard_OpenDist}">
                                <TextBlock Text="اختر الموزع الذي ستبدأ له الجولة:" FontSize="15" FontWeight="SemiBold" Foreground="#1F1F1F" />
                                <ComboBox ItemsSource="{Binding AvailableDistributorsForNewSession}"
                                          SelectedItem="{Binding SelectedDistributorForNewSession}"
                                          HorizontalAlignment="Stretch" Height="44" FontSize="15">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DistributorLookupItem">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="14" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="لا يوجد موزعون متاحون (جميع الموزعين لديهم جولات مفتوحة حالياً)."
                                           Classes="muted" FontSize="13"
                                           IsVisible="{Binding AvailableDistributorsForNewSession.Count,
                                           Converter={x:Static ObjectConverters.IsNull}}" />
                            </StackPanel>

                            <!-- STEP 2: Open_LoadVehicle — product buttons from warehouse -->
                            <StackPanel Spacing="12"
                                        IsVisible="{Binding IsWizard_OpenLoad}">
                                <Grid ColumnDefinitions="Auto,220,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="من مستودع:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#1F1F1F" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding WizardWarehouseOptions}"
                                              SelectedItem="{Binding WizardSelectedWarehouse}"
                                              HorizontalAlignment="Stretch" Height="36">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WarehouseLocationOption">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                               Text="اضغط ＋ على الصنف لإضافة وحدة للسيارة، اضغط − لتقليل الكمية." />
                                </Grid>

                                <!-- Product tiles in warehouse -->
                                <ItemsControl ItemsSource="{Binding WizardProducts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WizardProductButton">
                                            <Border Width="165" MinHeight="130" Margin="5"
                                                    Background="{Binding TileBackground}"
                                                    BorderBrush="{Binding TileBorderBrush}"
                                                    BorderThickness="2" CornerRadius="4">
                                                <Grid RowDefinitions="*,Auto,Auto,Auto" Margin="8,6">
                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding ProductName}"
                                                               TextWrapping="Wrap" TextAlignment="Center"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="13" FontWeight="Bold" Foreground="#1F1F1F" />
                                                    <ComboBox Grid.Row="1"
                                                              ItemsSource="{Binding AvailableUnits}"
                                                              SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                                              DisplayMemberBinding="{Binding UnitName}"
                                                              IsVisible="{Binding HasMultipleUnits}"
                                                              HorizontalAlignment="Center"
                                                              MinHeight="24" Height="24" FontSize="11"
                                                              Padding="6,1" Margin="0,2" />
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding AvailableText}"
                                                               Classes="muted" FontSize="11"
                                                               HorizontalAlignment="Center" Margin="0,2" />
                                                    <Grid Grid.Row="3" ColumnDefinitions="32,*,32" Margin="2,4,2,0">
                                                        <Button Grid.Column="0" Content="−" Classes="ghost"
                                                                Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).WizardRemoveProductCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding IsSelected}"
                                                                Width="32" Height="28" Padding="0"
                                                                FontSize="16" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding QtyText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="#0078D7" />
                                                        <Button Grid.Column="2" Content="＋" Classes="primary"
                                                                Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).WizardAddProductCommand}"
                                                                CommandParameter="{Binding}"
                                                                Width="32" Height="28" Padding="0" FontSize="14" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- STEP 3: Settle_Customer — search + create customer -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16"
                                  IsVisible="{Binding IsWizard_SettleCust}">

                                <!-- Left: Customer Search & Selection -->
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Text="ابحث عن العميل أو أنشئ عميلاً جديداً:" FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" Text="{Binding WizardCustomerSearch}"
                                                 PlaceholderText="اكتب اسم العميل للبحث..." Height="38" FontSize="14" />
                                        <Button Grid.Column="1" Classes="ghost" Content="➕ جديد"
                                                Command="{Binding WizardShowNewCustomerCommand}"
                                                Height="38" />
                                    </Grid>

                                    <!-- Search results ListBox -->
                                    <ListBox ItemsSource="{Binding WizardCustomerResults}"
                                             MaxHeight="160" MinHeight="40"
                                             Background="#FFFFFF"
                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                             IsVisible="{Binding WizardCustomerResults.Count}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CustomerLookupItem">
                                                <Button Classes="ghost" Content="{Binding DisplayText}"
                                                        Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).WizardSelectCustomerCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Right"
                                                        Padding="10,6" FontSize="13" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Selected customer badge -->
                                    <Border IsVisible="{Binding WizardSelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Background="#0078D7" Padding="12,8">
                                        <TextBlock Text="{Binding WizardSelectedCustomer.DisplayText}"
                                                   Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" />
                                    </Border>

                                    <!-- Inline new customer form -->
                                    <Border IsVisible="{Binding WizardIsNewCustomerVisible}"
                                            Background="#FFFFFF"
                                            BorderBrush="#0078D7" BorderThickness="1" Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="بيانات العميل الجديد" FontSize="13" FontWeight="Bold" Foreground="#0078D7" />
                                            <TextBox Text="{Binding WizardNewCustomerName}"    PlaceholderText="اسم العميل *" Height="34" />
                                            <TextBox Text="{Binding WizardNewCustomerPhone}"   PlaceholderText="رقم الهاتف"    Height="34" />
                                            <TextBox Text="{Binding WizardNewCustomerAddress}" PlaceholderText="العنوان"       Height="34" />
                                            <TextBlock Text="{Binding WizardNewCustomerError}" Foreground="#D24726" FontWeight="SemiBold"
                                                       IsVisible="{Binding WizardNewCustomerError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                <Button Grid.Column="0" Classes="primary" Content="✔ إنشاء وتحديد"
                                                        Command="{Binding WizardCreateCustomerCommand}" Height="32" />
                                                <Button Grid.Column="1" Classes="ghost" Content="إلغاء"
                                                        Command="{Binding WizardHideNewCustomerCommand}" Height="32" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: Session invoices list so far -->
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="فواتير هذه الجولة المسجلة حتى الآن:" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" />
                                    <Border Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1">
                                        <DataGrid ItemsSource="{Binding WizardSessionSales}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  MaxHeight="260" CanUserResizeColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}"        Width="85" />
                                                <DataGridTextColumn Header="العميل"    Binding="{Binding CustomerName}" Width="1.2*" />
                                                <DataGridTextColumn Header="النوع"     Binding="{Binding KindText}"     Width="110" />
                                                <DataGridTextColumn Header="القيمة"    Binding="{Binding TotalText}"    Width="85" />
                                                <DataGridTextColumn Header="المدفوع"   Binding="{Binding PaidCashText}" Width="85" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="عدد الفواتير" Classes="muted" FontSize="11" />
                                                <TextBlock Text="{Binding WizardInvoiceCount}" FontSize="20" FontWeight="Bold" Foreground="#1F1F1F" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="إجمالي المبيعات" Classes="muted" FontSize="11" />
                                                <TextBlock Text="{Binding WizardTotalSalesText}" FontSize="16" FontWeight="Bold" Foreground="#0078D7" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- STEP 4: Settle_Products — product tiles from vehicle -->
                            <StackPanel Spacing="10"
                                        IsVisible="{Binding IsWizard_SettleProd}">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <TextBlock Text="الأصناف على السيارة:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Background="#E8F1F8" BorderBrush="#0078D7" BorderThickness="1" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="الرصيد السابق للعميل:" Classes="muted" FontSize="12" />
                                                <TextBlock Text="{Binding WizardCustomerPreviousBalanceText}" FontWeight="Bold" FontSize="12" Foreground="#0078D7" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="إجمالي الفاتورة:" FontSize="13" Classes="muted" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding WizardCartTotalText}" FontSize="18" FontWeight="Bold" Foreground="#107C41" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding WizardProducts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WizardProductButton">
                                            <Border Width="165" MinHeight="145" Margin="5"
                                                    Background="{Binding TileBackground}"
                                                    BorderBrush="{Binding TileBorderBrush}"
                                                    BorderThickness="2" CornerRadius="4">
                                                <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" Margin="8,6">
                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding ProductName}"
                                                               TextWrapping="Wrap" TextAlignment="Center"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="13" FontWeight="Bold" Foreground="#1F1F1F" />
                                                    <ComboBox Grid.Row="1"
                                                              ItemsSource="{Binding AvailableUnits}"
                                                              SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                                              DisplayMemberBinding="{Binding UnitName}"
                                                              IsVisible="{Binding HasMultipleUnits}"
                                                              HorizontalAlignment="Center"
                                                              MinHeight="24" Height="24" FontSize="11"
                                                              Padding="6,1" Margin="0,2" />
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding PriceText}"
                                                               Foreground="#0078D7" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="3"
                                                               Text="{Binding LineTotalText}"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="#107C41"
                                                               HorizontalAlignment="Center"
                                                               IsVisible="{Binding IsSelected}" />
                                                    <Grid Grid.Row="4" ColumnDefinitions="32,*,32" Margin="2,4,2,0">
                                                        <Button Grid.Column="0" Content="−" Classes="ghost"
                                                                Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).WizardRemoveProductCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding IsSelected}"
                                                                Width="32" Height="28" Padding="0"
                                                                FontSize="16" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding QtyText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="#0078D7" />
                                                        <Button Grid.Column="2" Content="＋" Classes="primary"
                                                                Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).WizardAddProductCommand}"
                                                                CommandParameter="{Binding}"
                                                                Width="32" Height="28" Padding="0" FontSize="14" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Payment & Debt Collection Card -->
                                <Border Background="#FFFFFF" BorderBrush="#0078D7" BorderThickness="1" Padding="14" Margin="0,6,0,0">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="💳 الدفع والتحصيل للعميل:" FontWeight="Bold" FontSize="14" Foreground="#0078D7" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button Content="💵 نقدي بالكامل" Classes="ghost"
                                                        Command="{Binding SetWizardPaymentCashCommand}"
                                                        Background="{Binding WizardCashBtnBackground}"
                                                        Foreground="{Binding WizardCashBtnForeground}"
                                                        BorderBrush="#0078D7" BorderThickness="1"
                                                        Height="32" Padding="12,0" FontWeight="SemiBold" />
                                                <Button Content="📋 آجل بالكامل" Classes="ghost"
                                                        Command="{Binding SetWizardPaymentCreditCommand}"
                                                        Background="{Binding WizardCreditBtnBackground}"
                                                        Foreground="{Binding WizardCreditBtnForeground}"
                                                        BorderBrush="#D24726" BorderThickness="1"
                                                        Height="32" Padding="12,0" FontWeight="SemiBold" />
                                                <Button Content="⚖ دفع جزئي" Classes="ghost"
                                                        Command="{Binding SetWizardPaymentPartialCommand}"
                                                        Background="{Binding WizardPartialBtnBackground}"
                                                        Foreground="{Binding WizardPartialBtnForeground}"
                                                        BorderBrush="#107C41" BorderThickness="1"
                                                        Height="32" Padding="12,0" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*,1.3*" ColumnSpacing="12">
                                            <!-- 1. Paid from invoice -->
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="المدفوع نقداً من الفاتورة:" FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1F" />
                                                <TextBox Text="{Binding WizardPaidAmountText}" Height="34" FontSize="14" />
                                                <TextBlock Text="{Binding WizardRemainingCreditNotice}" FontSize="11" Foreground="#D24726" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- 2. Debt collection -->
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="تحصيل مديونية سابقة (إن وُجد):" FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1F" />
                                                <TextBox Text="{Binding WizardDebtCollectionText}" Height="34" FontSize="14" />
                                                <TextBlock Text="يُخصم من حساب العميل القديم" FontSize="11" Classes="muted" />
                                            </StackPanel>

                                            <!-- 3. Summary details -->
                                            <Border Grid.Column="2" Background="#F0F4F8" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="إجمالي المقبوض نقداً للموزع:" FontSize="12" FontWeight="Bold" Foreground="#107C41" />
                                                        <TextBlock Grid.Column="1" Text="{Binding WizardTotalCashFromCustomerText}" FontSize="14" FontWeight="Bold" Foreground="#107C41" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="رصيد العميل بعد المعاملة:" FontSize="11" Classes="muted" />
                                                        <TextBlock Grid.Column="1" Text="{Binding WizardProjectedBalanceText}" FontSize="12" FontWeight="Bold" Foreground="#1F1F1F" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- STEP 5: Settle_Finish — summary + cash count + close -->
                            <StackPanel Spacing="14"
                                        IsVisible="{Binding IsWizard_SettleFinish}">
                                <TextBlock Text="ملخص الجولة قبل الإغلاق النهائي والتسوية:" FontSize="15" FontWeight="Bold" Foreground="#1F1F1F" />

                                <!-- Financial breakdown KPI cards -->
                                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="إجمالي المبيعات" Classes="muted" FontSize="11" />
                                            <TextBlock Text="{Binding WizardTotalSalesText}" FontSize="15" FontWeight="Bold" Foreground="#1F1F1F" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#0078D7" BorderThickness="1" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="كاش المبيعات" Classes="muted" FontSize="11" />
                                            <TextBlock Text="{Binding WizardCashSalesText}" FontSize="15" FontWeight="Bold" Foreground="#0078D7" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D24726" BorderThickness="1" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="مبيعات آجلة" Classes="muted" FontSize="11" />
                                            <TextBlock Text="{Binding WizardCreditSalesText}" FontSize="15" FontWeight="Bold" Foreground="#D24726" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#107C41" BorderThickness="1" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="تحصيل ديون قديمة" Classes="muted" FontSize="11" />
                                            <TextBlock Text="{Binding WizardDebtCollectionsText}" FontSize="15" FontWeight="Bold" Foreground="#107C41" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="#F0F4F8" BorderBrush="#107C41" BorderThickness="2" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="الكاش المتوقع بالعهدة" FontSize="11" FontWeight="Bold" Foreground="#107C41" />
                                            <TextBlock Text="{Binding WizardExpectedCashText}" FontSize="16" FontWeight="Bold" Foreground="#107C41" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Invoices registered during wizard -->
                                <Border Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="📋 الفواتير والمعاملات المسجلة في الجولة:" FontSize="13" FontWeight="Bold" Foreground="#1F1F1F" />
                                        <DataGrid ItemsSource="{Binding WizardSessionSales}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  MaxHeight="140" CanUserResizeColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}"        Width="95" />
                                                <DataGridTextColumn Header="العميل"    Binding="{Binding CustomerName}" Width="1.4*" />
                                                <DataGridTextColumn Header="النوع"     Binding="{Binding KindText}"     Width="120" />
                                                <DataGridTextColumn Header="القيمة"    Binding="{Binding TotalText}"    Width="90" />
                                                <DataGridTextColumn Header="المدفوع"   Binding="{Binding PaidCashText}" Width="90" />
                                                <DataGridTextColumn Header="التاريخ"   Binding="{Binding Date}"         Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Unsold vehicle stock return to warehouse -->
                                <Border Background="#FFFFFF" BorderBrush="#0078D7" BorderThickness="1" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="📦 جرد السيارة والبضاعة المتبقية (ستعود تلقائياً إلى المخزن عند التأكيد):"
                                                       FontSize="13" FontWeight="Bold" Foreground="#0078D7" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="إرجاع تلقائي للمخزن" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding WizardUnsoldStockItems}"
                                                      IsVisible="{Binding WizardUnsoldStockItems.Count}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SessionUnsoldStockItem">
                                                    <Border Background="#F8F9FA" BorderBrush="#D0D0D0" BorderThickness="1"
                                                            Padding="10,6" Margin="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="#1F1F1F" />
                                                            <TextBlock Text=":" Classes="muted" />
                                                            <TextBlock Text="{Binding QuantityText}" FontWeight="Bold" FontSize="13" Foreground="#0078D7" />
                                                            <TextBlock Text="(متبقي بالسيارة)" FontSize="11" Classes="muted" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="لا توجد بضاعة متبقية بالسيارة (تم بيع كامل البضاعة المنقولة)."
                                                   Classes="muted" FontSize="12"
                                                   IsVisible="{Binding !WizardUnsoldStockItems.Count}" />
                                    </StackPanel>
                                </Border>

                                <!-- Counted cash input -->
                                <Border Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="الكاش الفعلي المعدود المستلم من الموزع:" FontSize="14" FontWeight="Bold" Foreground="#1F1F1F" />
                                            <TextBlock Text="المبلغ الفعلي الذي تم تسليمه لإغلاق العهدة وحساب العمولة." Classes="muted" FontSize="12" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding WizardCountedCash}"
                                                 PlaceholderText="0.00"
                                                 FontSize="22" Height="48"
                                                 Width="220" HorizontalContentAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                        </Panel>
                    </ScrollViewer>

                    <!-- ── Wizard footer (action buttons) ───────────────── -->
                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#D0D0D0"
                            BorderThickness="0,1,0,0" Padding="20,12">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                            <!-- Back button -->
                            <Button Grid.Column="0" Classes="ghost" Content="◀ رجوع"
                                    Command="{Binding WizardBackCommand}"
                                    IsVisible="{Binding IsWizard_OpenLoad}"
                                    Height="40" Padding="16,0" />
                            <Button Grid.Column="0" Classes="ghost" Content="◀ رجوع"
                                    Command="{Binding WizardBackCommand}"
                                    IsVisible="{Binding IsWizard_SettleProd}"
                                    Height="40" Padding="16,0" />
                            <Button Grid.Column="0" Classes="ghost" Content="◀ رجوع"
                                    Command="{Binding WizardBackCommand}"
                                    IsVisible="{Binding IsWizard_SettleFinish}"
                                    Height="40" Padding="16,0" />

                            <!-- Error message -->
                            <TextBlock Grid.Column="2" Text="{Binding WizardError}"
                                       Foreground="#D24726" FontWeight="Bold" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0"
                                       IsVisible="{Binding WizardError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <!-- انهاء الجولة button -->
                            <Button Grid.Column="3" Classes="ghost" Content="🏁 انهاء الجولة"
                                    Command="{Binding WizardGoToFinishCommand}"
                                    IsVisible="{Binding IsWizard_CanFinish}"
                                    Height="40" Padding="16,0" Margin="0,0,8,0" />

                            <!-- Primary action per step -->
                            <!-- Open: step 1 next -->
                            <Button Grid.Column="4" Classes="primary" Content="التالي ▶"
                                    Command="{Binding WizardNext_OpenToLoadCommand}"
                                    IsVisible="{Binding IsWizard_OpenDist}"
                                    Height="40" Padding="22,0" FontSize="14" FontWeight="Bold" />

                            <!-- Open: step 2 confirm load -->
                            <Button Grid.Column="4" Classes="primary" Content="✔ تحميل السيارة"
                                    Command="{Binding WizardConfirmLoadVehicleCommand}"
                                    IsVisible="{Binding IsWizard_OpenLoad}"
                                    Height="40" Padding="22,0" FontSize="14" FontWeight="Bold" />

                            <!-- Settle: customer → products -->
                            <Button Grid.Column="4" Classes="primary" Content="التالي ▶"
                                    Command="{Binding WizardNext_SettleToProductsCommand}"
                                    IsVisible="{Binding IsWizard_SettleCust}"
                                    Height="40" Padding="22,0" FontSize="14" FontWeight="Bold" />

                            <!-- Settle: register invoice → back to customer -->
                            <Button Grid.Column="4" Classes="primary" Content="{Binding WizardRegisterButtonText}"
                                    Command="{Binding WizardRegisterInvoiceCommand}"
                                    IsVisible="{Binding IsWizard_SettleProd}"
                                    Height="40" Padding="22,0" FontSize="14" FontWeight="Bold" />

                            <!-- Settle: finish → close session -->
                            <Button Grid.Column="4" Classes="primary" Content="✔ تأكيد الإغلاق"
                                    Command="{Binding WizardConfirmSettlementCommand}"
                                    IsVisible="{Binding IsWizard_SettleFinish}"
                                    Height="40" Padding="22,0" FontSize="14" FontWeight="Bold"
                                    Background="#D24726" />

                            <!-- Cancel -->
                            <Button Grid.Column="5" Classes="ghost" Content="إلغاء"
                                    Command="{Binding WizardCancelCommand}"
                                    Height="40" Padding="14,0" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
        SESSION DETAILS DIALOG OVERLAY — spans both rows, sits above everything
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsSessionDetailsDialogVisible}">

            <!-- Dark Backdrop -->
            <Border Background="#88000000" />

            <!-- Centered Dialog Card — 100% Solid Opaque -->
            <Border Background="#FFFFFF"
                    BorderBrush="#0078D7"
                    BorderThickness="2"
                    Width="980" Height="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 35 0 #88000000"
                    Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#0078D7" Padding="20,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="📄 تفاصيل وفواتير الجولة #" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SelectedSessionDetails.SessionId}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="—" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SelectedSessionDetails.DistributorName}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border Background="#FFFFFF" Padding="8,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SelectedSessionDetails.StatusText}" FontSize="12" FontWeight="Bold" Foreground="#0078D7" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Classes="ghost"
                                    Command="{Binding CloseSessionDetailsDialogCommand}"
                                    Foreground="#FFFFFF" Background="Transparent"
                                    BorderThickness="0"
                                    Width="32" Height="32" Padding="0"
                                    FontSize="16" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" Padding="16" Background="#F8F9FA">
                        <StackPanel Spacing="14">

                            <!-- KPIs -->
                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="إجمالي المبيعات" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.TotalSalesText}" FontSize="15" FontWeight="Bold" Foreground="#1F1F1F" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#0078D7" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="كاش المبيعات" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.CashSalesText}" FontSize="15" FontWeight="Bold" Foreground="#0078D7" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D24726" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="مبيعات آجلة" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.CreditSalesText}" FontSize="15" FontWeight="Bold" Foreground="#D24726" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#107C41" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="تحصيل ديون قديمة" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.DebtCollectionsText}" FontSize="15" FontWeight="Bold" Foreground="#107C41" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="#F0F4F8" BorderBrush="#107C41" BorderThickness="2" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="إجمالي المقبوض كاش" FontSize="11" FontWeight="Bold" Foreground="#107C41" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.TotalCashReceivedText}" FontSize="16" FontWeight="Bold" Foreground="#107C41" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Time & Settled Financials -->
                            <Border Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="وقت الفتح:" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.OpenedAt}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="وقت الإغلاق:" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.ClosedAt}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="الكاش المعدود:" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.CountedCashText}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock Text="فرق الكاش:" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.CashDiffText}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="2">
                                        <TextBlock Text="العمولة المستحقة:" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedSessionDetails.CommissionText}" FontWeight="SemiBold" FontSize="12" Foreground="#8764B8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Invoices section -->
                            <Border Background="#FFFFFF" BorderBrush="#0078D7" BorderThickness="1" Padding="12">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="🛒 فواتير المبيعات المسجلة بالجولة" FontSize="14" FontWeight="Bold" Foreground="#0078D7" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSessionDetails.InvoicesCount, StringFormat='({0} فاتورة)'}" Classes="muted" FontSize="12" />
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding SelectedSessionDetails.Invoices}"
                                              SelectedItem="{Binding SelectedInvoiceInDetails}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              MaxHeight="160" CanUserResizeColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding DocNo}" Width="100" />
                                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="1.5*" />
                                            <DataGridTextColumn Header="طريقة السداد" Binding="{Binding PaymentTypeLabel}" Width="110" />
                                            <DataGridTextColumn Header="إجمالي الفاتورة" Binding="{Binding TotalText}" Width="110" />
                                            <DataGridTextColumn Header="المدفوع نقداً" Binding="{Binding PaidCashText}" Width="110" />
                                            <DataGridTextColumn Header="المتبقي آجل" Binding="{Binding RemainingCreditText}" Width="110" />
                                            <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Lines of selected invoice -->
                                    <Border Background="#F8F9FA" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10"
                                            IsVisible="{Binding SelectedInvoiceInDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="📦 أصناف الفاتورة المحددة أعلاه:" FontWeight="Bold" FontSize="12" Foreground="#1F1F1F" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedInvoiceInDetails.DocNo, StringFormat='فاتورة رقم: {0}'}" Classes="muted" FontSize="11" />
                                            </Grid>
                                            <DataGrid ItemsSource="{Binding SelectedInvoiceInDetails.Lines}"
                                                      AutoGenerateColumns="False" IsReadOnly="True"
                                                      MaxHeight="120" CanUserResizeColumns="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="2*" />
                                                    <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="1*" />
                                                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPriceText}" Width="1*" />
                                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="1*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Debt Collections & Stock Movements side by side -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <!-- Debt Collections -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="💰 سندات تحصيل الديون القديمة" FontSize="13" FontWeight="Bold" Foreground="#107C41" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedSessionDetails.CollectionsCount, StringFormat='({0})'}" Classes="muted" FontSize="12" />
                                        </Grid>
                                        <DataGrid ItemsSource="{Binding SelectedSessionDetails.Collections}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  MaxHeight="130" CanUserResizeColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}" Width="90" />
                                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="1.5*" />
                                                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountText}" Width="90" />
                                                <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="100" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Stock Movements (Load & Return) -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="🚛 حركة البضاعة (التحميل والإرجاع)" FontSize="13" FontWeight="Bold" Foreground="#0078D7" />
                                        <DataGrid ItemsSource="{Binding SelectedSessionDetails.StockMovements}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  MaxHeight="130" CanUserResizeColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="الحركة" Binding="{Binding TypeLabel}" Width="100" />
                                                <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}" Width="90" />
                                                <DataGridTextColumn Header="من / إلى" Binding="{Binding ItemsSummary}" Width="1.5*" />
                                                <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="100" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="20,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="تم تحميل كافة البيانات المالية وحركات المخزون الخاصة بالجولة من قاعدة البيانات."
                                       Classes="muted" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="primary" Content="إغلاق"
                                    Command="{Binding CloseSessionDetailsDialogCommand}"
                                    Height="36" Padding="24,0" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>

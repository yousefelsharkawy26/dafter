<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daftar.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Daftar.Views.ReceiveView"
             x:DataType="vm:ReceiveViewModel"
             FlowDirection="RightToLeft">

    <UserControl.Styles>
        <!-- Product tile, in the Start button's blue.
             These two screens override the shared tile style in Theme/Components.axaml, so the
             palette is repeated here rather than inherited; both now point at the same three
             values the Start button uses, so the shop reads as one family.

             Every line of text inside the tile is set white. A TextBlock does not take its
             foreground from the button, so without the catch-all below the SKU, the unit and the
             on-hand figures stay dark navy on a dark blue background. The out-of-stock badge on
             the receive tile has no style of its own at all, and the catch-all is what makes it
             legible. -->
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="#0078D7" />
            <Setter Property="BorderBrush" Value="#0078D7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A86E8" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#005A9E" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <!-- Out of stock stays pale: it is the one state that has to look different, and grey on
             a blue grid reads as "not this one" faster than any label does.

             It has to stay READABLE, though, and that is where repainting the tile went wrong.
             Theme/Components.axaml already fades every disabled tile to 0.55 opacity, which a pale
             card with navy text survived and grey-on-grey does not. The result was out-of-stock
             products rendering at about half strength: a cashier scanning for what has run out
             could not read what had. Cancelling the fade here and using a darker grey keeps the
             state obvious without making the name unreadable. -->
        <Style Selector="Button.tile TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tile TextBlock.strong">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.tile TextBlock.price">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Targeting TextBlock directly, not through the presenter: the catch-all rule above sets
             Foreground on each TextBlock, and a setter that goes via the template loses to it. The
             first attempt did exactly that and left white text on a pale tile, which is the same
             unreadable result as no fix at all.

             This block is last on purpose. Avalonia resolves two rules setting the same property by
             order within the collection, not by specificity, so a catch-all placed after the
             disabled rule silently wins and the tile stays white-on-pale. -->
        <Style Selector="Button.tile:disabled">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="#E9E9E9" />
            <Setter Property="BorderBrush" Value="#BFBFBF" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.tile:disabled TextBlock">
            <Setter Property="Foreground" Value="#3A3A3A" />
        </Style>
    </UserControl.Styles>

    <!--
        استلام بضاعة / Purchasing & Receiving screen
        Two-panel modern workspace matching SellView:
        Left: Product catalog with search and tiles
        Right: Receive invoice panel with editable lines, OCR scan, supplier details & settlement
    -->
    <Grid Margin="{StaticResource PagePadding}"
          ColumnSpacing="{StaticResource SpaceLg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================
             Column 0: Products Catalog (Search + Tiles)
             ======================================================== -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              RowSpacing="{StaticResource SpaceMd}">

            <!-- Search Bar + Items count -->
            <Grid Grid.Row="0"
                  ColumnSpacing="{StaticResource SpaceMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="SearchBox"
                         Text="{Binding ProductSearchText}"
                         KeyDown="OnSearchKeyDown"
                         PlaceholderText="ابحث باسم الصنف أو امسح الباركود للاستلام"
                         FontSize="{StaticResource FontSizeSubtitle}"
                         Height="{StaticResource SearchHeight}"
                         VerticalContentAlignment="Center">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource IconSearch}"
                                  Width="16"
                                  Height="16"
                                  Margin="12,0"
                                  Opacity="0.6" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <Button Grid.Column="1"
                        Classes="ghost"
                        Height="{StaticResource SearchHeight}"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding !Scanning}"
                        ToolTip.Tip="قراءة فاتورة المورد تلقائياً من صورة ضوئية عبر الذكاء الاصطناعي">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="📷" FontSize="16" />
                        <TextBlock Text="مسح فاتورة (صورة)" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="2"
                           Classes="caption"
                           VerticalAlignment="Center"
                           Text="{Binding FilteredProducts.Count, StringFormat='{}{0} صنف'}" />
            </Grid>

            <!-- Product Tiles Grid -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ui:FAItemsRepeater ItemsSource="{Binding FilteredProducts}"
                                        Margin="0,0,0,8">
                        <ui:FAItemsRepeater.Layout>
                            <ui:FAUniformGridLayout MinItemWidth="{StaticResource TileMinWidth}"
                                                    MinItemHeight="{StaticResource TileHeight}"
                                                    MinRowSpacing="{StaticResource SpaceSm}"
                                                    MinColumnSpacing="{StaticResource SpaceSm}"
                                                    ItemsStretch="Fill" />
                        </ui:FAItemsRepeater.Layout>

                        <ui:FAItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReceiveProductOption">
                                <Button Classes="tile"
                                        Command="{Binding $parent[UserControl].((vm:ReceiveViewModel)DataContext).SelectProductCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Display}">
                                    <Grid RowDefinitions="Auto,*,Auto">

                                        <!-- SKU + Stock flag -->
                                        <Grid Grid.Row="0"
                                              ColumnSpacing="{StaticResource SpaceSm}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Sku}"
                                                       Classes="caption"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="1"
                                                    Classes="badge info"
                                                    IsVisible="{Binding HasStock}">
                                                <TextBlock Text="{Binding OnHandText}" FontSize="11" />
                                            </Border>
                                        </Grid>

                                        <!-- Product Name & Unit Selection -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,3">
                                            <TextBlock Text="{Binding Name}"
                                                       Classes="strong"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ComboBox ItemsSource="{Binding AvailableUnits}"
                                                      SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                                      DisplayMemberBinding="{Binding UnitName}"
                                                      IsVisible="{Binding HasMultipleUnits}"
                                                      HorizontalAlignment="Center"
                                                      MinHeight="24" Height="24" FontSize="11"
                                                      Padding="6,1" Margin="0,2,0,0"
                                                      ToolTip.Tip="اختيار وحدة الاستلام" />
                                            <TextBlock Text="{Binding UnitName, StringFormat='({0})'}"
                                                       Classes="caption"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"
                                                       IsVisible="{Binding !HasMultipleUnits}" />
                                        </StackPanel>

                                        <!-- Purchase Price / Unit -->
                                        <Grid Grid.Row="2"
                                              ColumnSpacing="{StaticResource SpaceXs}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PurchasePriceText}"
                                                       Classes="price"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UnitName, StringFormat='/ {}{0}'}"
                                                       Classes="caption"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="＋ إضافة"
                                                       Classes="caption"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ui:FAItemsRepeater.ItemTemplate>
                    </ui:FAItemsRepeater>
                </ScrollViewer>

                <!-- Empty search results -->
                <StackPanel Spacing="{StaticResource SpaceXs}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !FilteredProducts.Count}">
                    <PathIcon Data="{StaticResource IconSearch}"
                              Width="40"
                              Height="40"
                              Opacity="0.35"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="لا توجد أصناف مطابقة"
                               Classes="subtitle"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="جرّب اسماً آخر أو امسح الباركود"
                               Classes="caption"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========================================================
             Column 1: Receive Invoice Panel (Lines + Settlement)
             ======================================================== -->
        <Border Grid.Column="1" Classes="panel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0"
                      ColumnSpacing="{StaticResource SpaceSm}"
                      Margin="16,14,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="فاتورة الاستلام"
                               Classes="subtitle"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1"
                            Classes="badge count"
                            IsVisible="{Binding Lines.Count}">
                        <TextBlock Text="{Binding Lines.Count}" />
                    </Border>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpaceXs}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Lines.Count}">
                        <Button Classes="ghost"
                                Command="{Binding RequestClearCommand}"
                                IsVisible="{Binding !IsClearConfirmVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconTrash}"
                                          Width="14"
                                          Height="14" />
                                <TextBlock Text="تفريغ الفاتورة"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource SpaceXs}"
                                    IsVisible="{Binding IsClearConfirmVisible}">
                            <Button Classes="danger"
                                    Content="تأكيد التفريغ"
                                    Command="{Binding ClearCommand}" />
                            <Button Classes="ghost"
                                    Content="إلغاء"
                                    Command="{Binding CancelClearCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Middle Content Area (OCR Review or Empty State or Lines) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- OCR Scanned Invoice Review Banner -->
                    <Border Grid.Row="0" Classes="card" Margin="12,4,12,8"
                            Background="#FFFDF2" BorderBrush="#FFD54F" BorderThickness="1.5"
                            CornerRadius="6"
                            IsVisible="{Binding HasScan}">
                        <StackPanel Spacing="8" Margin="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="📄 مراجعة الفاتورة الممسوحة ضوئياً"
                                               FontWeight="Bold" FontSize="13" Foreground="#B78103" />
                                    <TextBlock Classes="muted" Text="{Binding ScanStatus}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="ghost" Content="تجاهل" Padding="8,4"
                                            Command="{Binding DiscardScanCommand}" />
                                    <Button Classes="primary" Content="أضف السطور للاستلام" Padding="10,4"
                                            Command="{Binding ConfirmScanCommand}" />
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="#FFFFFF">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Scanned}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ScannedRow">
                                                <Border BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="4,6">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="130,110,80,55,65,Auto"
                                                              ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0" Text="{Binding Text}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" FontSize="11"
                                                                       ToolTip.Tip="{Binding RawText}" />
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding Choices}"
                                                                      SelectedItem="{Binding Product}"
                                                                      PlaceholderText="الصنف" FontSize="11" Height="28">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ProductRow">
                                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ComboBox Grid.Column="2"
                                                                      ItemsSource="{Binding AvailableUnits}"
                                                                      SelectedItem="{Binding Unit}"
                                                                      PlaceholderText="الوحدة" FontSize="11" Height="28">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:UnitRow">
                                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <TextBox Grid.Column="3" Text="{Binding Quantity}"
                                                                     FontSize="11" Height="28" Padding="4,2"
                                                                     ToolTip.Tip="الكمية" />
                                                            <TextBox Grid.Column="4" Text="{Binding UnitPrice}"
                                                                     FontSize="11" Height="28" Padding="4,2"
                                                                     ToolTip.Tip="سعر الوحدة في الفاتورة" />
                                                            <CheckBox Grid.Column="5"
                                                                      IsChecked="{Binding UpdateProductPurchasePrice, Mode=TwoWay}"
                                                                      IsVisible="{Binding HasPriceDiscrepancy}"
                                                                      Content="تحديث سعر النظام"
                                                                      FontSize="10"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip.Tip="تحديث سعر الشراء المرجعي لهذا الصنف في النظام عند حفظ الفاتورة" />
                                                        </Grid>
                                                        <TextBlock IsVisible="{Binding HasPriceDiscrepancy}"
                                                                   Text="{Binding PriceComparisonText}"
                                                                   FontSize="10"
                                                                   Foreground="#B78103"
                                                                   Margin="4,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Empty receipt placeholder -->
                    <StackPanel Grid.Row="1"
                                Spacing="{StaticResource SpaceXs}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !Lines.Count}">
                        <PathIcon Data="{StaticResource IconCart}"
                                  Width="40"
                                  Height="40"
                                  Opacity="0.35"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="الفاتورة فارغة"
                                   Classes="subtitle"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="اضغط على أي صنف أو امسح الباركود أو اضغط «مسح فاتورة (صورة)» لإضافتها"
                                   Classes="caption"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="280"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Receive lines list -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding Lines.Count}">
                        <ItemsControl ItemsSource="{Binding Lines}"
                                      Margin="8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReceiveLine">
                                    <Border Classes="divider-bottom"
                                            Padding="{StaticResource RowPadding}">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                              RowSpacing="{StaticResource SpaceXs}">

                                            <!-- Product Name & Line Total -->
                                            <Grid Grid.Row="0"
                                                  ColumnSpacing="{StaticResource SpaceMd}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProductName}"
                                                           Classes="strong"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LineTotalText}"
                                                           Classes="strong"
                                                           FontWeight="Bold"
                                                           Foreground="#107C41"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Base quantity indicator -->
                                            <Grid Grid.Row="1"
                                                  ColumnSpacing="{StaticResource SpaceSm}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding BaseQuantityText, StringFormat='المخزون الأساسي: {0}'}"
                                                           Classes="caption"
                                                           Opacity="0.75" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Sku}"
                                                           Classes="caption"
                                                           Opacity="0.6" />
                                            </Grid>

                                            <!-- Controls: Unit selector | Quantity | Unit Price | Remove -->
                                            <Grid Grid.Row="2"
                                                  ColumnSpacing="{StaticResource SpaceSm}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Unit dropdown -->
                                                <ComboBox ItemsSource="{Binding AvailableUnits}"
                                                          SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                                          DisplayMemberBinding="{Binding UnitName}"
                                                          MinWidth="75"
                                                          Height="28"
                                                          Padding="6,2"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="تغيير وحدة القياس" />

                                                <!-- Quantity controls (+, input, -) -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="4">
                                                    <Button Classes="icon"
                                                            Command="{Binding $parent[UserControl].((vm:ReceiveViewModel)DataContext).DecrementLineCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="تقليل الكمية">
                                                        <TextBlock Text="−"
                                                                   FontSize="18"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </Button>

                                                    <TextBox Text="{Binding QuantityInput, Mode=TwoWay}"
                                                             MinWidth="48"
                                                             Width="52"
                                                             Height="28"
                                                             Padding="4,2"
                                                             TextAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             FontSize="12"
                                                             FontWeight="SemiBold"
                                                             ToolTip.Tip="تعديل الكمية" />

                                                    <Button Classes="icon"
                                                            Command="{Binding $parent[UserControl].((vm:ReceiveViewModel)DataContext).IncrementLineCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="زيادة الكمية">
                                                        <TextBlock Text="+"
                                                                   FontSize="18"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- Unit price input -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="السعر:" Classes="caption" VerticalAlignment="Center" Opacity="0.7" />
                                                    <TextBox Text="{Binding UnitPriceInput, Mode=TwoWay}"
                                                             Width="68"
                                                             Height="28"
                                                             Padding="4,2"
                                                             TextAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             FontSize="12"
                                                             FontWeight="SemiBold"
                                                             ToolTip.Tip="سعر شراء الوحدة" />
                                                </StackPanel>

                                                <!-- Remove button -->
                                                <Button Grid.Column="3"
                                                        Classes="icon remove"
                                                        Command="{Binding $parent[UserControl].((vm:ReceiveViewModel)DataContext).RemoveLineCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="حذف الصنف من الفاتورة">
                                                    <PathIcon Data="{StaticResource IconTrash}"
                                                              Width="16"
                                                              Height="16" />
                                                </Button>
                                            </Grid>

                                            <!-- Row 3: Reference price update approval (if discrepancy) -->
                                            <Grid Grid.Row="3"
                                                  IsVisible="{Binding HasPriceDiscrepancy}"
                                                  ColumnDefinitions="Auto,*"
                                                  Margin="0,2,0,0">
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding UpdateProductPurchasePrice, Mode=TwoWay}"
                                                          Content="تحديث سعر الشراء في النظام"
                                                          FontSize="11"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="تحديث سعر الشراء المرجعي لهذا الصنف في النظام تلقائياً عند حفظ الفاتورة" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PriceDiscrepancyText}"
                                                           FontSize="11"
                                                           Foreground="#B78103"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ========================================================
                     Footer: Supplier + Invoice No + Settlement + Post
                     ======================================================== -->
                <Border Grid.Row="2"
                        Classes="divider-top"
                        Padding="{StaticResource CardPadding}">
                    <StackPanel Spacing="{StaticResource SpaceSm}">

                        <!-- Supplier selection -->
                        <Grid RowDefinitions="Auto"
                              ColumnSpacing="{StaticResource SpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="المورد"
                                       Classes="caption"
                                       VerticalAlignment="Center" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="{StaticResource ControlHeight}"
                                      PlaceholderText="اختار المورد">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SupplierOption">
                                        <TextBlock Text="{Binding Display}" Classes="body" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Supplier Invoice Reference Number -->
                        <Grid RowDefinitions="Auto"
                              ColumnSpacing="{StaticResource SpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="رقم الفاتورة"
                                       Classes="caption"
                                       VerticalAlignment="Center" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding InvoiceNo}"
                                     Height="{StaticResource ControlHeight}"
                                     PlaceholderText="رقم فاتورة المورد (اختياري)"
                                     VerticalContentAlignment="Center" />
                        </Grid>

                        <!-- Settlement Options (Payment Mode) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="طريقة السداد للمورد:" Classes="caption" Opacity="0.75" />
                                <ComboBox ItemsSource="{Binding Settlement.Choices}"
                                          SelectedItem="{Binding Settlement.Choice}"
                                          HorizontalAlignment="Stretch"
                                          Height="{StaticResource ControlHeight}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettlementOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Partial payment amount if Partial choice selected -->
                            <StackPanel Grid.Column="1" Spacing="2"
                                        IsVisible="{Binding Settlement.IsPartial}">
                                <TextBlock Text="المبلغ المدفوع:" Classes="caption" Opacity="0.75" />
                                <TextBox Text="{Binding Settlement.PartialAmount}"
                                         Width="110"
                                         Height="{StaticResource ControlHeight}"
                                         PlaceholderText="0.00" />
                            </StackPanel>
                        </Grid>

                        <!-- Payment method selection (Cash vs Wallet only) -->
                        <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding Settlement.IsActive}">
                            <TextBlock Text="وسيلة السداد:" Classes="caption" Opacity="0.75" />
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0"
                                        Content="💵 كاش (الخزينة)"
                                        Command="{Binding Settlement.SelectCashCommand}"
                                        Classes.accent="{Binding Settlement.IsCashMethod}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        MinHeight="{StaticResource ControlHeight}"
                                        Margin="0,0,3,0" />
                                <Button Grid.Column="1"
                                        Content="📱 محفظة إلكترونية"
                                        Command="{Binding Settlement.SelectWalletCommand}"
                                        Classes.accent="{Binding Settlement.IsWalletMethod}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        MinHeight="{StaticResource ControlHeight}"
                                        Margin="3,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- Wallet account selection (only if Wallet is chosen; Cash defaults to Cashier) -->
                        <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding Settlement.IsWalletMethod}">
                            <TextBlock Text="المحفظة المسدد منها:" Classes="caption" Opacity="0.75" />
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0"
                                        Content="فودافون كاش"
                                        Command="{Binding Settlement.SelectVodafoneCashCommand}"
                                        Classes.accent="{Binding Settlement.IsVodafoneCashActive}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        MinHeight="{StaticResource ControlHeight}"
                                        Margin="0,0,2,0" />
                                <Button Grid.Column="1"
                                        Content="انستاباي"
                                        Command="{Binding Settlement.SelectInstapayCommand}"
                                        Classes.accent="{Binding Settlement.IsInstapayActive}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        MinHeight="{StaticResource ControlHeight}"
                                        Margin="2,0,0,0" />
                            </Grid>
                            
                               
                        </StackPanel>

                        <!-- Total display -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,2">
                            <TextBlock Text="إجمالي الاستلام:"
                                       Classes="subtitle"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TotalText}"
                                       Classes="title"
                                       FontWeight="Bold"
                                       Foreground="#107C41"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Status & Post Hint -->
                        <TextBlock Classes="caption"
                                   Text="{Binding PostHint}"
                                   Foreground="#D83B01"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding PostHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <TextBlock Classes="caption muted"
                                   Text="{Binding Status}"
                                   TextWrapping="Wrap" />

                        <!-- Save / Post Button -->
                        <Button Classes="primary"
                                Height="{StaticResource ControlHeightLg}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding PostCommand}"
                                IsEnabled="{Binding CanPost}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpaceSm}">
                                <PathIcon Data="{StaticResource IconCheck}"
                                          Width="16"
                                          Height="16" />
                                <TextBlock Text="حفظ وتأكيد الاستلام"
                                           Classes="strong"
                                           FontSize="{StaticResource FontSizeSubtitle}"
                                           Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daftar.ViewModels"
             xmlns:components="using:Daftar.Views.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Daftar.Views.PaymentsView"
             x:DataType="vm:PaymentsViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{StaticResource PagePadding}">

        <!-- ========================================================
             1. Header: Liquidity KPIs & Treasury Account Cards
             ======================================================== -->
        <Border Grid.Row="0" Classes="panel" Margin="0,0,0,12" Padding="16,12">
            <StackPanel Spacing="12">
                <!-- Top Row: Title & Action -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="المقبوضات وإدارة الخزينة" Classes="subtitle" FontWeight="Bold" />
                        <TextBlock Text="تحصيل مستحقات العملاء، سداد الموردين، تسجيل المصروفات، والتحويل بين الخزائن والبنوك" Classes="caption muted" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" Grid.Column="1">
                        <!-- Action Launch Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Button Classes="accent"
                                    Command="{Binding OpenVoucherDialogCommand}"
                                    Padding="16,8" Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="➕" FontSize="14" />
                                    <TextBlock Text="تسجيل عملية جديدة" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Command="{Binding LoadCommand}" ToolTip.Tip="تحديث الأرصدة والحركات">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="تحديث" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </Grid>
                </Grid>

                <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- KPIs & Balances Grid -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <!-- Total Liquidity Card -->
                    <components:KpiTile Grid.Column="0" Label="إجمالي السيولة المتاحة" Value="{Binding TotalLiquidity, StringFormat='{}{0:N2} ج.م'}" ValueBrush="{DynamicResource AccentFillColorDefaultBrush}" />

                    <!-- Cash Drawer Balance Card -->
                    <components:KpiTile Grid.Column="1" Label="الخزينة النقدية (الكاشير) 💵" Value="{Binding CashDrawerBalance, StringFormat='{}{0:N2} ج.م'}" ValueBrush="#107C41" />

                    <!-- Wallets Balance Card -->
                    <components:KpiTile Grid.Column="2" Label="المحافظ الإلكترونية 📱" Value="{Binding WalletsBalance, StringFormat='{}{0:N2} ج.م'}" ValueBrush="#0078D4" />

                    <!-- Today Net Flow -->
                    <Border Grid.Column="3" Classes="surface" Padding="14,10">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="صافي حركة اليوم" Classes="caption muted" />
                                <TextBlock Grid.Column="1" Text="{Binding TodayNetFlow, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding TodayReceiptsTotal, StringFormat='وارد: +{0:N0}'}" Classes="caption" Foreground="#107C41" />
                                <TextBlock Text="|" Classes="caption muted" />
                                <TextBlock Text="{Binding TodayPaymentsTotal, StringFormat='صادر: -{0:N0}'}" Classes="caption" Foreground="#D13438" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Accounts Breakdown (Live Balances) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TreasuryAccounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TreasuryAccountCard">
                                <Border Classes="surface" Padding="10,6" MinWidth="170">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                        <TextBlock Grid.Row="0" Text="{Binding TypeLabel}" Classes="caption muted" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding BalanceText}" FontWeight="Bold" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <!-- ========================================================
             3. Unified Vouchers & Treasury History Table
             ======================================================== -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">

            <!-- Left: Table & Filter Bar -->
            <Border Grid.Column="0" Classes="panel">
                <Grid RowDefinitions="Auto,*" Margin="12">

                    <!-- Search & Filter Bar -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                        <components:SearchBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" Placeholder="ابحث بالطرف، رقم السند، الحساب المالي، أو المرجع..." />

                        <!-- Quick Filter Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="ghost" Content="الكل"
                                    Command="{Binding FilterHistoryAllCommand}"
                                    IsEnabled="{Binding !IsFilterAllActive}" />
                            <Button Classes="ghost" Content="مقبوضات (وارد)"
                                    Command="{Binding FilterHistoryInflowCommand}"
                                    IsEnabled="{Binding !IsFilterInflowActive}" />
                            <Button Classes="ghost" Content="مدفوعات (صادر)"
                                    Command="{Binding FilterHistoryOutflowCommand}"
                                    IsEnabled="{Binding !IsFilterOutflowActive}" />
                            <Button Classes="ghost" Content="اليوم"
                                    Command="{Binding FilterHistoryTodayCommand}"
                                    IsEnabled="{Binding !IsFilterTodayActive}" />
                            <Button Classes="ghost" Content="هذا الشهر"
                                    Command="{Binding FilterHistoryMonthCommand}"
                                    IsEnabled="{Binding !IsFilterMonthActive}" />
                        </StackPanel>
                    </Grid>

                    <!-- History DataGrid -->
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding FilteredRecent}"
                                  SelectedItem="{Binding SelectedVoucher, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}" Width="*" />
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding DocDate, StringFormat='yyyy-MM-dd'}" Width="110" />

                                <!-- Direction Badge Column -->
                                <DataGridTemplateColumn Header="النوع" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:VoucherRow">
                                            <Border Classes="badge success" IsVisible="{Binding IsInflow}" HorizontalAlignment="Center">
                                                <TextBlock Text="وارد (قبض)" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:VoucherRow">
                                            <Border Classes="badge danger" IsVisible="{Binding !IsInflow}" HorizontalAlignment="Center">
                                                <TextBlock Text="صادر (دفع)" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="الطرف / العميل / المورد" Binding="{Binding Party}" Width="1.3*" />
                                <DataGridTextColumn Header="الحساب المالي (الخزينة)" Binding="{Binding Account}" Width="1.6*" />
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding MethodLabel}" Width="1.4*" />
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountText}" Width="1.3*" />

                                <!-- Details Action Button -->
                                <DataGridTemplateColumn Header="تفاصيل" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:VoucherRow">
                                            <Button Classes="icon"
                                                    Command="{Binding $parent[UserControl].((vm:PaymentsViewModel)DataContext).SelectVoucherCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    ToolTip.Tip="عرض تفاصيل السند">
                                                <TextBlock Text="👁️" FontSize="13" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty Search Notification -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" IsVisible="{Binding !FilteredRecent.Count}">
                            <TextBlock Text="💳" FontSize="36" HorizontalAlignment="Center" Opacity="0.4" />
                            <TextBlock Text="لا توجد سندات أو حركات مطابقة" Classes="subtitle" HorizontalAlignment="Center" />
                            <TextBlock Text="يمكنك تسجيل حركة جديدة من النماذج أعلاه" Classes="caption muted" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Voucher Details Drawer / Panel -->
            <Border Grid.Column="1" Width="330" Classes="panel" IsVisible="{Binding IsDetailsDrawerOpen}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="14">
                    <!-- Drawer Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding SelectedVoucher.DocNo, StringFormat='سند: {0}'}" Classes="heading" Margin="0" />
                            <TextBlock Text="{Binding SelectedVoucher.DocDate, StringFormat='بتاريخ: {0:yyyy-MM-dd}'}" Classes="caption muted" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="✕" Command="{Binding CloseDetailsDrawerCommand}" />
                    </Grid>

                    <!-- Details Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <Border Classes="surface" Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="نوع الحركة:" Classes="caption muted" Width="90" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.DirectionLabel}" FontWeight="Bold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="الطرف:" Classes="caption muted" Width="90" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.Party}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="الحساب المالي:" Classes="caption muted" Width="90" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.Account}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="طريقة الدفع:" Classes="caption muted" Width="90" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.MethodLabel}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding SelectedVoucher.Reference, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="الرقم المرجعي:" Classes="caption muted" Width="90" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.Reference}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="حالة الترحيل:" Classes="caption muted" Width="90" />
                                        <Border Grid.Column="1" Classes="badge success" HorizontalAlignment="Left">
                                            <TextBlock Text="مرحّل في الخزينة" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Footer Amount -->
                    <Border Grid.Row="2" Classes="surface" Padding="12" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="مبلغ السند:" Classes="subtitle" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.AmountText}" Classes="price" FontSize="18" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================
             4. Bottom Status Notification Bar
             ======================================================== -->
        <Border Grid.Row="3" Classes="surface" Padding="14,8" Margin="0,10,0,0"
                CornerRadius="6"
                IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="🔔" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="caption strong" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ========================================================
             5. Floating Modal Dialog Overlay (سندات، مصروفات، تحويلات)
             ======================================================== -->
        <components:ModalDialog IsVisible="{Binding IsActionDialogOpen}"
                             Title="{Binding ActionDialogTitle}"
                             Subtitle="أدخل تفاصيل العملية المالية ثم اضغط ترحيل"
                             CloseCommand="{Binding CloseActionDialogCommand}"
                             BackdropCloses="True"
                             DialogWidth="820"
                             ZIndex="1000">

            <components:ModalDialog.HeaderExtra>
            <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="tab-btn"
                            Classes.accent="{Binding IsVouchersTabActive}"
                            Command="{Binding ShowVouchersTabCommand}"
                            Padding="10,6">
                        <TextBlock Text="📝 سند طرف" FontWeight="SemiBold" FontSize="12" />
                    </Button>
                    <Button Classes="tab-btn"
                            Classes.accent="{Binding IsMovementsTabActive}"
                            Command="{Binding ShowMovementsTabCommand}"
                            Padding="10,6">
                        <TextBlock Text="💸 مصروف" FontWeight="SemiBold" FontSize="12" />
                    </Button>
                    <Button Classes="tab-btn"
                            Classes.accent="{Binding IsTransfersTabActive}"
                            Command="{Binding ShowTransfersTabCommand}"
                            Padding="10,6">
                        <TextBlock Text="🔄 تحويل" FontWeight="SemiBold" FontSize="12" />
                    </Button>
</StackPanel>
            </components:ModalDialog.HeaderExtra>

            <components:ModalDialog.Body>
                <Panel>
                    <!-- FORM 0: Party Voucher (سند قبض / صرف) -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsVouchersTabActive}">
                        <!-- Row 1: Direction & Payment Method -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                            <!-- Direction -->
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="نوع السند والاتجاه *" Classes="caption muted" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="tab-btn"
                                            Classes.accent="{Binding IsInflowDirection}"
                                            Command="{Binding SelectInflowDirectionCommand}"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="📥" FontSize="14" />
                                            <TextBlock Text="تحصيل من عميل (وارد)" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tab-btn"
                                            Classes.accent="{Binding IsOutflowDirection}"
                                            Command="{Binding SelectOutflowDirectionCommand}"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="📤" FontSize="14" />
                                            <TextBlock Text="سداد لمورد (صادر)" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Payment Method (Cash vs Wallets) -->
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="طريقة الاستلام / الدفع *" Classes="caption muted" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="tab-btn"
                                            Classes.accent="{Binding IsCashMethod}"
                                            Command="{Binding SelectCashCommand}"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="💵" FontSize="14" />
                                            <TextBlock Text="كاش (الخزينة)" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tab-btn"
                                            Classes.accent="{Binding IsVodafoneCashActive}"
                                            Command="{Binding SelectVodafoneCashCommand}"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="📱" FontSize="14" />
                                            <TextBlock Text="فودافون كاش" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tab-btn"
                                            Classes.accent="{Binding IsInstapayActive}"
                                            Command="{Binding SelectInstapayCommand}"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="⚡" FontSize="14" />
                                            <TextBlock Text="انستاباي" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Party Selection & Outstanding Balance Quick Fill -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="العميل المحصَّل منه *"
                                           Classes="caption muted"
                                           IsVisible="{Binding IsInflowDirection}" />
                                <TextBlock Text="المورد المسدَّد له *"
                                           Classes="caption muted"
                                           IsVisible="{Binding IsOutflowDirection}" />
                                <ComboBox ItemsSource="{Binding FilteredParties}"
                                          SelectedItem="{Binding Party, Mode=TwoWay}"
                                          PlaceholderText="ابحث أو اختر..."
                                          HorizontalAlignment="Stretch"
                                          Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PartyOption">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Outstanding Balance Badge -->
                            <components:KpiTile Grid.Column="1" IsVisible="{Binding Outstanding, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Label="حالة الرصيد:" Value="{Binding Outstanding}" />

                            <!-- Quick Fill Full Outstanding Button -->
                            <Button Grid.Column="2" Classes="accent"
                                    Command="{Binding FillFullOutstandingCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="38" Padding="16,0"
                                    IsVisible="{Binding Outstanding, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    ToolTip.Tip="سداد كامل المبلغ المفتوح بنقرة واحدة">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="⚡" FontSize="14" />
                                    <TextBlock Text="سداد كامل المستحق" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 3: Amount, Reference & Confirm Post Button -->
                        <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <!-- Amount Input -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="المبلغ (ج.م) *" Classes="caption muted" />
                                <TextBox Text="{Binding Amount, Mode=TwoWay}"
                                         PlaceholderText="0.00"
                                         FontSize="16" FontWeight="Bold"
                                         Height="40"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Reference / Notes Input -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="رقم الإيصال / مرجع التحويل أو هاتف المحفظة (اختياري)" Classes="caption muted" />
                                <TextBox Text="{Binding Reference, Mode=TwoWay}"
                                         PlaceholderText="مثال: تحويل فودافون كاش #123456 أو إيصال تسليم"
                                         Height="40"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Post Button -->
                            <Button Grid.Column="2" Classes="accent"
                                    Command="{Binding PostCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="40" Padding="24,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="✓" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="تأكيد وترحيل السند" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- FORM 1: Direct Expense / Cash Movement -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsMovementsTabActive}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="نوع الحركة *" Classes="caption muted" />
                                <ComboBox ItemsSource="{Binding MovementKinds}"
                                          SelectedItem="{Binding SelectedMovementKind, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MovementKindOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="تصنيف المصروف *" Classes="caption muted" />
                                <ComboBox ItemsSource="{Binding ExpenseCategories}"
                                          SelectedItem="{Binding SelectedExpenseCategory, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExpenseCategoryOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="الحساب المدفوع منه / إليه *" Classes="caption muted" />
                                <ComboBox ItemsSource="{Binding AllAccounts}"
                                          SelectedItem="{Binding MovementAccount, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountRow">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="المبلغ (ج.م) *" Classes="caption muted" />
                                <TextBox Text="{Binding MovementAmount, Mode=TwoWay}"
                                         PlaceholderText="0.00"
                                         FontSize="16" FontWeight="Bold"
                                         Height="38"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="البيان / الملاحظات" Classes="caption muted" />
                            <TextBox Text="{Binding MovementNotes, Mode=TwoWay}"
                                     PlaceholderText="مثال: فاتورة كهرباء شهر أكتوبر..."
                                     Height="38"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <Button Classes="accent"
                                Command="{Binding PostMovementCommand}"
                                HorizontalAlignment="Right"
                                Height="40" Padding="24,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="تسجيل وترحيل المصروف" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- FORM 2: Treasury Account Transfer -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsTransfersTabActive}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="من حساب (المصدر) *" Classes="caption muted" />
                                <ComboBox ItemsSource="{Binding AllAccounts}"
                                          SelectedItem="{Binding TransferFromAccount, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountRow">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="إلى حساب (الوجهة) *" Classes="caption muted" />
                                <ComboBox ItemsSource="{Binding AllAccounts}"
                                          SelectedItem="{Binding TransferToAccount, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountRow">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="المبلغ المحول (ج.م) *" Classes="caption muted" />
                                <TextBox Text="{Binding TransferAmount, Mode=TwoWay}"
                                         PlaceholderText="0.00"
                                         FontSize="16" FontWeight="Bold"
                                         Height="38"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="ملاحظات التحويل" Classes="caption muted" />
                                <TextBox Text="{Binding TransferNotes, Mode=TwoWay}"
                                         PlaceholderText="مثال: توريد كاش إلى المحفظة الإلكترونية..."
                                         Height="38"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Button Classes="accent"
                                Command="{Binding PostTransferCommand}"
                                HorizontalAlignment="Right"
                                Height="40" Padding="24,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="تأكيد وترحيل التحويل" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Panel>
            </components:ModalDialog.Body>

            <components:ModalDialog.Footer>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Status}"
                               Classes="caption strong"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Content="إغلاق"
                            Command="{Binding CloseActionDialogCommand}"
                            Padding="16,6" />
                </Grid>
            </components:ModalDialog.Footer>
        </components:ModalDialog>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daftar.ViewModels"
             xmlns:components="using:Daftar.Views.Components"
             x:Class="Daftar.Views.PartiesView"
             x:DataType="vm:PartiesViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- Top filter & action bar -->
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                <!-- Search input -->
                <TextBox Grid.Column="0" Text="{Binding SearchText}"
                         PlaceholderText="بحث بالاسم أو الكود أو رقم الهاتف..." />

                <!-- Role filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="الكل"
                            Command="{Binding SetFilterRoleCommand}">
                        <Button.CommandParameter>
                            <x:Int32>0</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                    <Button Classes="ghost" Content="عملاء"
                            Command="{Binding SetFilterRoleCommand}">
                        <Button.CommandParameter>
                            <x:Int32>1</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                    <Button Classes="ghost" Content="موردين"
                            Command="{Binding SetFilterRoleCommand}">
                        <Button.CommandParameter>
                            <x:Int32>2</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                </StackPanel>

                <!-- Status message -->
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Classes="muted"
                           VerticalAlignment="Center" Margin="8,0" />

                <!-- Refresh -->
                <Button Grid.Column="3" Classes="ghost" Content="تحديث"
                        Command="{Binding LoadPartiesCommand}" />

                <!-- Add New Party Button -->
                <Button Grid.Column="4" Classes="accent"
                        Command="{Binding OpenAddPartyDialogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="إضافة طرف جديد" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main content: List + Details / Statement -->
        <Grid Grid.Row="1" ColumnDefinitions="*,440" ColumnSpacing="14">

            <!-- Left: Parties DataGrid -->
            <Border Grid.Column="0" Classes="card">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Classes="heading" Text="قائمة الأطراف (العملاء والموردين)" Margin="0,0,0,8" />

                    <DataGrid ItemsSource="{Binding FilteredParties}"
                              SelectedItem="{Binding SelectedParty}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="90" />
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="النوع" Binding="{Binding RoleDisplay}" Width="100" />
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="110" />
                            <DataGridTemplateColumn Header="الرصيد الحالي" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PartyListItem">
                                        <TextBlock Text="{Binding BalanceText}"
                                                   Foreground="{Binding BalanceColor}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="تعديل" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PartyListItem">
                                        <Button Classes="icon"
                                                Command="{Binding $parent[UserControl].((vm:PartiesViewModel)DataContext).OpenEditPartyDialogCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Center"
                                                ToolTip.Tip="تعديل بيانات الطرف">
                                            <TextBlock Text="✏️" FontSize="13" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right: Selected Party Details + Statement -->
            <Border Grid.Column="1" Classes="card">
                <DockPanel LastChildFill="True">
                    <!-- Top section: Details header and info -->
                    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="heading" Text="بيانات الطرف المحدد" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost"
                                    Command="{Binding OpenEditPartyDialogCommand}"
                                    CommandParameter="{Binding SelectedParty}"
                                    IsEnabled="{Binding SelectedParty, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="تعديل بيانات هذا الطرف">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="✏️" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="تعديل البيانات" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding SelectedParty.Name, FallbackValue='لم يتم تحديد طرف'}"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedParty.RoleDisplay}" Classes="muted" />
                                <TextBlock Text="{Binding SelectedParty.Phone, StringFormat='الهاتف: {0}'}" Classes="muted"
                                           IsVisible="{Binding SelectedParty.Phone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding SelectedParty.Address, StringFormat='العنوان: {0}'}" Classes="muted"
                                           IsVisible="{Binding SelectedParty.Address, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding SelectedParty.TaxNumber, StringFormat='الرقم الضريبي: {0}'}" Classes="muted"
                                           IsVisible="{Binding SelectedParty.TaxNumber, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding SelectedParty.CreditLimitDisplay, StringFormat='حد الائتمان: {0}'}" Classes="muted"
                                           IsVisible="{Binding SelectedParty, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="الرصيد" Classes="muted" />
                                <TextBlock Text="{Binding SelectedParty.BalanceText, FallbackValue='0.00'}"
                                           Classes="tile-value"
                                           Foreground="{Binding SelectedParty.BalanceColor, FallbackValue='#666666'}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <!-- Account Statement Title -->
                        <TextBlock Classes="heading" Text="كشف الحساب (آخر الحركات)" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Account Statement DataGrid taking remainder height -->
                    <DataGrid ItemsSource="{Binding Transactions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="120" />
                            <DataGridTextColumn Header="البيان" Binding="{Binding KindDisplay}" Width="*" />
                            <DataGridTemplateColumn Header="المبلغ" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PartyTransactionRow">
                                        <TextBlock Text="{Binding AmountText}"
                                                   Foreground="{Binding AmountColor}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <components:ModalDialog IsVisible="{Binding IsPartyDialogOpen}"
                             Title="{Binding DialogTitle}"
                             Subtitle="أدخل بيانات العميل أو المورد ثم اضغط حفظ"
                             CloseCommand="{Binding ClosePartyDialogCommand}"
                             BackdropCloses="True"
                             DialogWidth="520"
                             ZIndex="1000">

            <components:ModalDialog.Body>
                <StackPanel Spacing="14">
                    <!-- Name -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="الاسم *" Classes="caption muted" />
                        <TextBox Text="{Binding FormName, Mode=TwoWay}"
                                 PlaceholderText="اسم العميل أو المورد"
                                 Height="38" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Phone and Code -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="رقم الهاتف" Classes="caption muted" />
                            <TextBox Text="{Binding FormPhone, Mode=TwoWay}"
                                     PlaceholderText="01xxxxxxxxx"
                                     Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="الكود" Classes="caption muted" />
                            <TextBox Text="{Binding FormCode, Mode=TwoWay}"
                                     PlaceholderText="تلقائي إذا ترك فارغاً"
                                     Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Address and Tax Number -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="العنوان أو المنطقة" Classes="caption muted" />
                            <TextBox Text="{Binding FormAddress, Mode=TwoWay}"
                                     PlaceholderText="العنوان بالتفصيل"
                                     Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="الرقم الضريبي (اختياري)" Classes="caption muted" />
                            <TextBox Text="{Binding FormTaxNumber, Mode=TwoWay}"
                                     PlaceholderText="الرقم الضريبي"
                                     Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Party Role (Customer / Supplier checkboxes) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="نوع الطرف *" Classes="caption muted" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <CheckBox IsChecked="{Binding FormIsCustomer, Mode=TwoWay}" Content="عميل" />
                            <CheckBox IsChecked="{Binding FormIsSupplier, Mode=TwoWay}" Content="مورد" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Credit Limit -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="حد الائتمان (0 = نقدي فقط بدون آجل)" Classes="caption muted" />
                        <TextBox Text="{Binding FormCreditLimit, Mode=TwoWay}"
                                 PlaceholderText="0.00"
                                 Height="38" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding DialogErrorMessage}"
                               Classes="caption danger"
                               IsVisible="{Binding DialogErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </components:ModalDialog.Body>

            <components:ModalDialog.Footer>
                <components:DialogActions IsBusy="{Binding IsBusy}" CancelCommand="{Binding ClosePartyDialogCommand}" SaveCommand="{Binding SavePartyCommand}" SaveText="{Binding SaveButtonText}" />
            </components:ModalDialog.Footer>
        </components:ModalDialog>

    </Grid>
</UserControl>
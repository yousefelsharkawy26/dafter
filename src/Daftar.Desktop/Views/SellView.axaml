<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daftar.ViewModels"
             xmlns:components="using:Daftar.Views.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Daftar.Views.SellView"
             x:DataType="vm:SellViewModel"
             FlowDirection="RightToLeft">

    <!--
        بيع / Sales screen
        All bindings below match the current SellViewModel, SettlementPanel,
        ProductOption, PartyOption and CartLine APIs.
    -->

    <Grid Margin="{StaticResource PagePadding}"
          ColumnSpacing="{StaticResource SpaceLg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource CartPanelWidth}" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================
             Products: search + tiles
             ======================================================== -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              RowSpacing="{StaticResource SpaceMd}">

            <Grid Grid.Row="0"
                  ColumnSpacing="{StaticResource SpaceMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <components:SearchBox Name="SearchBox" KeyDown="OnSearchKeyDown" Text="{Binding ProductSearchText}" Placeholder="ابحث باسم الصنف أو امسح الباركود" Large="True" />

                <TextBlock Grid.Column="1"
                           Classes="caption"
                           VerticalAlignment="Center"
                           Text="{Binding FilteredProducts.Count, Converter={StaticResource ArabicCount}, ConverterParameter='صنف|صنفان|أصناف'}" />
            </Grid>

            <Grid Grid.Row="1">
                <!-- The tiles, and the grid they sit in, are one component now.
                     Both screens used to carry this block verbatim. -->
                <components:ProductTileGrid ItemsSource="{Binding FilteredProducts}" />

            </Grid>
        </Grid>

        <!-- ========================================================
             Order panel: header → lines → checkout
             ======================================================== -->
        <Border Grid.Column="1" Classes="panel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0"
                      ColumnSpacing="{StaticResource SpaceSm}"
                      Margin="16,14,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="سلة المشتريات"
                               Classes="subtitle"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1"
                            Classes="badge count"
                            IsVisible="{Binding Cart.Count}">
                        <TextBlock Text="{Binding Cart.Count}" />
                    </Border>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpaceXs}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Cart.Count}">
                        <Button Classes="ghost"
                                Command="{Binding RequestClearCommand}"
                                IsVisible="{Binding !IsClearConfirmVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconTrash}"
                                          Width="14"
                                          Height="14" />
                                <TextBlock Text="تفريغ السلة"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource SpaceXs}"
                                    IsVisible="{Binding IsClearConfirmVisible}">
                            <Button Classes="danger"
                                    Content="تأكيد التفريغ"
                                    Command="{Binding ClearCommand}" />
                            <Button Classes="ghost"
                                    Content="إلغاء"
                                    Command="{Binding CancelClearCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Empty cart -->
                <StackPanel Grid.Row="1"
                            Spacing="{StaticResource SpaceXs}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !Cart.Count}">
                    <PathIcon Data="{StaticResource IconCart}"
                              Width="40"
                              Height="40"
                              Opacity="0.35"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="السلة فارغة"
                               Classes="subtitle"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="اضغط على أي صنف أو امسح الباركود لإضافته"
                               Classes="caption"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Cart lines -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding Cart.Count}">
                    <ItemsControl ItemsSource="{Binding Cart}"
                                  Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CartLine">
                                <Border Classes="divider-bottom"
                                        Padding="{StaticResource RowPadding}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                          RowSpacing="{StaticResource SpaceXs}">

                                        <!-- name | line total -->
                                        <Grid Grid.Row="0"
                                              ColumnSpacing="{StaticResource SpaceMd}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Classes="strong"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LineTotalText}"
                                                       Classes="strong"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- unit price -->
                                        <Grid Grid.Row="1"
                                              ColumnSpacing="{StaticResource SpaceSm}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PriceByQuantityText, StringFormat='{}{}{0}'}"
                                                       Classes="caption" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UnitName}"
                                                       Classes="caption"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- unit | quantity controls | delete -->
                                        <Grid Grid.Row="2"
                                              ColumnSpacing="{StaticResource SpaceSm}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding AvailableUnits}"
                                                      SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                                      DisplayMemberBinding="{Binding UnitName}"
                                                      MinWidth="75"
                                                      Height="28"
                                                      Padding="6,2"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="تغيير وحدة القياس" />

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="6">
                                                <Button Classes="icon"
                                                        Command="{Binding $parent[UserControl].((vm:SellViewModel)DataContext).DecrementLineCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="تقليل الكمية">
                                                    <TextBlock Text="−"
                                                               FontSize="20"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>

                                                <TextBox Text="{Binding QuantityInput, Mode=TwoWay}"
                                                         MinWidth="52"
                                                         Width="56"
                                                         Height="28"
                                                         Padding="4,2"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         FontSize="13"
                                                         FontWeight="SemiBold"
                                                         ToolTip.Tip="تعديل الكمية مباشرة" />

                                                <Button Classes="icon"
                                                        Command="{Binding $parent[UserControl].((vm:SellViewModel)DataContext).IncrementLineCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="زيادة الكمية">
                                                    <TextBlock Text="+"
                                                               FontSize="20"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Classes="icon remove"
                                                    Command="{Binding $parent[UserControl].((vm:SellViewModel)DataContext).RemoveLineCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="حذف الصنف من السلة">
                                                <PathIcon Data="{StaticResource IconTrash}"
                                                          Width="16"
                                                          Height="16" />
                                            </Button>
                                        </Grid>

                                        <!-- Existing line discount, when present -->
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding DiscountSummaryText, StringFormat='خصم: {}{0}'}"
                                                   Classes="caption success"
                                                   IsVisible="{Binding HasDiscount}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Checkout footer -->
                <Border Grid.Row="2"
                        Classes="divider-top"
                        Padding="{StaticResource CardPadding}">
                    <StackPanel Spacing="{StaticResource SpaceMd}">

                        <!-- Customer -->
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="{StaticResource SpaceXs}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="العميل"
                                       Classes="caption"
                                       VerticalAlignment="Center" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="{StaticResource ControlHeight}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartyOption">
                                        <TextBlock Text="{Binding Display}"
                                                   Classes="body"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1">
                                <TextBlock Text="{Binding SelectedCustomerBalanceText}"
                                           Classes="caption danger"
                                           FontWeight="SemiBold"
                                           IsVisible="{Binding IsSelectedCustomerInDebt}" />
                                <TextBlock Text="{Binding SelectedCustomerBalanceText}"
                                           Classes="caption success"
                                           FontWeight="SemiBold"
                                           IsVisible="{Binding IsSelectedCustomerInCredit}" />
                            </StackPanel>
                        </Grid>

                        <!-- Settlement -->
                        <StackPanel Spacing="{StaticResource SpaceSm}">
                            <Grid ColumnSpacing="{StaticResource SpaceSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الدفع"
                                           Classes="caption"
                                           VerticalAlignment="Center" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Settlement.Choices}"
                                          SelectedItem="{Binding Settlement.Choice}"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="{StaticResource ControlHeight}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettlementOption">
                                            <TextBlock Text="{Binding Label}"
                                                       Classes="body"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Partial amount -->
                            <Grid ColumnSpacing="{StaticResource SpaceSm}"
                                  IsVisible="{Binding Settlement.IsPartial}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="مبلغ الدفع الجزئي"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Settlement.PartialAmount}"
                                         PlaceholderText="مثلاً 500"
                                         HorizontalAlignment="Stretch"
                                         MinHeight="{StaticResource ControlHeight}" />
                                <TextBlock Grid.Column="2"
                                           Text="ج.م"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Payment method (Cash vs Wallet only) -->
                            <Grid ColumnSpacing="{StaticResource SpaceSm}"
                                  IsVisible="{Binding Settlement.IsActive}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="طريقة الدفع"
                                           Classes="caption"
                                           VerticalAlignment="Center" />

                                <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                    <Button Grid.Column="0"
                                            Content="💵 كاش (الخزينة)"
                                            Command="{Binding Settlement.SelectCashCommand}"
                                            Classes.accent="{Binding Settlement.IsCashMethod}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            MinHeight="{StaticResource ControlHeight}"
                                            Margin="0,0,3,0" />
                                    <Button Grid.Column="1"
                                            Content="📱 محفظة إلكترونية"
                                            Command="{Binding Settlement.SelectWalletCommand}"
                                            Classes.accent="{Binding Settlement.IsWalletMethod}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            MinHeight="{StaticResource ControlHeight}"
                                            Margin="3,0,0,0" />
                                </Grid>
                            </Grid>

                            <!-- Destination wallet (only shown when Wallet is chosen; Cash defaults to Cashier automatically) -->
                            <Grid ColumnSpacing="{StaticResource SpaceSm}"
                                  IsVisible="{Binding Settlement.IsWalletMethod}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المحفظة"
                                           Classes="caption"
                                           VerticalAlignment="Center" />

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0"
                                                Content="فودافون كاش"
                                                Command="{Binding Settlement.SelectVodafoneCashCommand}"
                                                Classes.accent="{Binding Settlement.IsVodafoneCashActive}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                MinHeight="{StaticResource ControlHeight}"
                                                Margin="0,0,2,0" />
                                        <Button Grid.Column="1"
                                                Content="انستاباي"
                                                Command="{Binding Settlement.SelectInstapayCommand}"
                                                Classes.accent="{Binding Settlement.IsInstapayActive}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                MinHeight="{StaticResource ControlHeight}"
                                                Margin="2,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <TextBlock Classes="error"
                                       Text="{Binding Settlement.Problem}"
                                       IsVisible="{Binding Settlement.Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Totals -->
                        <StackPanel Spacing="{StaticResource SpaceXs}">
                            <Grid>
                                <Grid.ColumnDefinitions> 
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="المجموع الفرعي"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SubtotalText}"
                                           Classes="body" />
                            </Grid>

                            <!-- Invoice Discount Input -->
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="خصم الفاتورة"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding InvoiceDiscountText, Mode=TwoWay}"
                                         PlaceholderText="0.00"
                                         Height="28"
                                         Padding="6,2"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         FontSize="12" />
                            </Grid>
                            <TextBlock Classes="error"
                                       FontSize="11"
                                       Margin="0,-2,0,2"
                                       Text="{Binding InvoiceDiscountError}"
                                       IsVisible="{Binding InvoiceDiscountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <Grid IsVisible="{Binding HasTotalDiscount}">
                                <Grid.ColumnDefinitions> 
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="إجمالي الخصم"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Classes="strong success"
                                           Text="{Binding TotalDiscountText, StringFormat='- {}{0}'}" />
                            </Grid>

                            <Grid ColumnSpacing="6"
                                  Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                  
                                <TextBlock Text="الإجمالي"
                                           Classes="subtitle"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalText}"
                                           Classes="display"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="ج.م"
                                           Classes="caption"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,7" />
                            </Grid>

                            <Grid IsVisible="{Binding IsPaymentDeferredOrPartial}">
                                <Grid.ColumnDefinitions> 
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المتبقي على العميل"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AmountDueText}"
                                           Classes="strong caution"
                                           FontWeight="Bold" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding Status}"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Checkout -->
                        <Button Classes="accent"
                                Command="{Binding PostCommand}"
                                IsEnabled="{Binding CanPostNow}"
                                Height="{StaticResource ControlHeightLg}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ui:FAProgressRing Width="20"
                                                   Height="20"
                                                   IsIndeterminate="True"
                                                   IsVisible="{Binding Busy}" />
                                <PathIcon Data="{StaticResource IconCheck}"
                                          Width="20"
                                          Height="20"
                                          IsVisible="{Binding !Busy}" />
                                <TextBlock Text="إتمام البيع"
                                           FontSize="{StaticResource FontSizeSubtitle}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

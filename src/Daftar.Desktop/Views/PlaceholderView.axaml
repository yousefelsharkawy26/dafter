<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daftar.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Daftar.Views.PlaceholderView"
             x:DataType="vm:TabViewModel"
             FlowDirection="RightToLeft">

    <!--
        Binds to the tab rather than assigning x:Name fields from code. Reaching for named
        elements on DataContextChanged depends on initialisation order and throws when the
        DataContext is set before the template is applied.
    -->
    <Border Margin="40">
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="#1F1F1F" />
            <TextBlock Text="{Binding Caption}" FontSize="14" Foreground="#666666" />
            <TextBlock Text="الشاشة دي لسه مش متعملة" FontSize="12" Foreground="#888888" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>